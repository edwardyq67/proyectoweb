import Inicio from '../components/Inicio.astro';
import Nosotros from '../components/Nosotros.astro';
import Productos from '../components/Productos.jsx';
import Layout from '../layouts/Layout.astro';
import Contacto from '../components/Contacto.jsx';
---

<Layout title="TS Group">
	<Inicio />
	<Nosotros />
	
	<!-- Estos NO se renderizarán en el servidor -->
	<Carrusel client:only="react"/>
	<Productos client:only="react" />
	<Contacto client:only="react" tipo="Informacion" />
</Layout>