---
// Politicas.astro
import Layout from '../layouts/Layout.astro';

// Fecha dinámica
const currentDate = new Date();
const formattedDate = currentDate.toLocaleDateString('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<Layout title="Política de Privacidad - TS GROUP">
  <div class="min-h-screen bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 py-12">
      <!-- Tarjeta principal -->
      <div class="bg-white rounded-2xl shadow-xl p-6 md:p-10">
        <!-- Encabezado -->
        <div class="border-b border-gray-200 pb-8 mb-8">
          <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
            Política de Privacidad
          </h1>
          <div class="flex flex-col md:flex-row md:items-center md:justify-between">
            <p class="text-gray-600 italic">
              Última actualización: {formattedDate}
            </p>
            <div class="mt-2 md:mt-0">
              <span class="inline-block px-3 py-1 bg-blue-100 text-blue-800 text-sm font-medium rounded-full">
                TS GROUP
              </span>
            </div>
          </div>
        </div>

        <!-- Introducción -->
        <div class="mb-10 p-6 bg-blue-50 rounded-xl border border-blue-100">
          <p class="text-gray-700 leading-relaxed">
            En <strong class="text-blue-700">TS GROUP</strong>, nos comprometemos a proteger su privacidad y garantizar la seguridad de su información personal. Esta Política de Privacidad describe cómo recopilamos, usamos, compartimos y protegemos sus datos personales.
          </p>
        </div>

        <!-- Sección 1 -->
        <div class="mb-10">
          <h2 class="text-2xl font-bold text-gray-900 mb-6 pb-2 border-b border-gray-200">
            1. Información que Recopilamos
          </h2>
          <p class="text-gray-700 mb-4">
            Podemos recopilar los siguientes tipos de información:
          </p>
          <ul class="space-y-3 ml-5">
            <li class="flex items-start">
              <span class="inline-block w-2 h-2 bg-blue-600 rounded-full mt-2 mr-3 flex-shrink-0"></span>
              <span class="text-gray-700">
                <strong class="text-gray-900">Información de identificación personal:</strong> nombre, dirección de correo electrónico, número de teléfono, dirección postal.
              </span>
            </li>
            <li class="flex items-start">
              <span class="inline-block w-2 h-2 bg-blue-600 rounded-full mt-2 mr-3 flex-shrink-0"></span>
              <span class="text-gray-700">
                <strong class="text-gray-900">Información técnica:</strong> dirección IP, tipo de navegador, páginas visitadas, tiempo de permanencia en el sitio.
              </span>
            </li>
            <li class="flex items-start">
              <span class="inline-block w-2 h-2 bg-blue-600 rounded-full mt-2 mr-3 flex-shrink-0"></span>
              <span class="text-gray-700">
                <strong class="text-gray-900">Información de comunicación:</strong> preferencias de contacto, historial de comunicaciones con nuestro equipo.
              </span>
            </li>
          </ul>
        </div>

        <!-- Sección 2 -->
        <div class="mb-10">
          <h2 class="text-2xl font-bold text-gray-900 mb-6 pb-2 border-b border-gray-200">
            2. Cómo Utilizamos Su Información
          </h2>
          <p class="text-gray-700 mb-4">
            Utilizamos la información recopilada para:
          </p>
          <ul class="grid grid-cols-1 md:grid-cols-2 gap-3 ml-5">
            <li class="flex items-start">
              <span class="text-blue-600 mr-2">✓</span>
              <span class="text-gray-700">Proporcionar y mejorar nuestros servicios</span>
            </li>
            <li class="flex items-start">
              <span class="text-blue-600 mr-2">✓</span>
              <span class="text-gray-700">Responder a sus consultas y solicitudes</span>
            </li>
            <li class="flex items-start">
              <span class="text-blue-600 mr-2">✓</span>
              <span class="text-gray-700">Enviar comunicaciones sobre nuestros servicios</span>
            </li>
            <li class="flex items-start">
              <span class="text-blue-600 mr-2">✓</span>
              <span class="text-gray-700">Personalizar su experiencia en nuestro sitio web</span>
            </li>
            <li class="flex items-start md:col-span-2">
              <span class="text-blue-600 mr-2">✓</span>
              <span class="text-gray-700">Cumplir con obligaciones legales y regulatorias</span>
            </li>
          </ul>
        </div>

        <!-- Sección 3 -->
        <div class="mb-10">
          <h2 class="text-2xl font-bold text-gray-900 mb-6 pb-2 border-b border-gray-200">
            3. Compartir Información
          </h2>
          <p class="text-gray-700 mb-4">
            No vendemos ni alquilamos su información personal a terceros. Podemos compartir su información en las siguientes circunstancias:
          </p>
          <div class="bg-red-50 border border-red-100 rounded-lg p-5 mb-6">
            <div class="flex items-start">
              <span class="text-red-600 text-xl mr-3">⚠</span>
              <p class="text-gray-700">
                <strong class="text-red-700">Importante:</strong> Su información es confidencial y solo se comparte bajo estrictas circunstancias.
              </p>
            </div>
          </div>
          <ul class="space-y-3 ml-5">
            <li class="flex items-start">
              <span class="text-gray-700">
                Con proveedores de servicios que nos ayudan a operar nuestro negocio
              </span>
            </li>
            <li class="flex items-start">
              <span class="text-gray-700">
                Cuando sea requerido por ley o para proteger nuestros derechos legales
              </span>
            </li>
            <li class="flex items-start">
              <span class="text-gray-700">
                En caso de fusión, adquisición o venta de activos de la empresa
              </span>
            </li>
          </ul>
        </div>

        <!-- Sección 4 -->
        <div class="mb-10">
          <h2 class="text-2xl font-bold text-gray-900 mb-6 pb-2 border-b border-gray-200">
            4. Seguridad de la Información
          </h2>
          <p class="text-gray-700 mb-4">
            Implementamos medidas de seguridad técnicas y organizativas apropiadas para proteger su información personal contra acceso no autorizado, alteración, divulgación o destrucción.
          </p>
          <div class="bg-green-50 border border-green-100 rounded-lg p-5 mt-4">
            <div class="flex items-start">
              <span class="text-green-600 text-xl mr-3">🔒</span>
              <p class="text-gray-700">
                <strong class="text-green-700">Nuestro compromiso:</strong> Utilizamos tecnologías de última generación para proteger sus datos. Sin embargo, ningún método de transmisión por Internet o almacenamiento electrónico es 100% seguro.
              </p>
            </div>
          </div>
        </div>

        <!-- Sección 5 -->
        <div class="mb-10">
          <h2 class="text-2xl font-bold text-gray-900 mb-6 pb-2 border-b border-gray-200">
            5. Cookies y Tecnologías Similares
          </h2>
          <p class="text-gray-700">
            Nuestro sitio web utiliza cookies y tecnologías similares para mejorar su experiencia de navegación. Puede configurar su navegador para rechazar cookies, aunque esto puede afectar algunas funcionalidades del sitio.
          </p>
        </div>

        <!-- Sección 6 -->
        <div class="mb-10">
          <h2 class="text-2xl font-bold text-gray-900 mb-6 pb-2 border-b border-gray-200">
            6. Sus Derechos
          </h2>
          <p class="text-gray-700 mb-4">
            Usted tiene derecho a:
          </p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="bg-gray-50 p-4 rounded-lg">
              <h3 class="font-semibold text-gray-900 mb-2">Acceso</h3>
              <p class="text-gray-700 text-sm">Acceder a la información personal que tenemos sobre usted</p>
            </div>
            <div class="bg-gray-50 p-4 rounded-lg">
              <h3 class="font-semibold text-gray-900 mb-2">Corrección</h3>
              <p class="text-gray-700 text-sm">Solicitar la corrección de información inexacta</p>
            </div>
            <div class="bg-gray-50 p-4 rounded-lg">
              <h3 class="font-semibold text-gray-900 mb-2">Eliminación</h3>
              <p class="text-gray-700 text-sm">Solicitar la eliminación de su información personal</p>
            </div>
            <div class="bg-gray-50 p-4 rounded-lg">
              <h3 class="font-semibold text-gray-900 mb-2">Portabilidad</h3>
              <p class="text-gray-700 text-sm">Solicitar la portabilidad de sus datos</p>
            </div>
          </div>
        </div>

        <!-- Sección 7 -->
        <div class="mb-10">
          <h2 class="text-2xl font-bold text-gray-900 mb-6 pb-2 border-b border-gray-200">
            7. Retención de Datos
          </h2>
          <p class="text-gray-700">
            Conservamos su información personal solo durante el tiempo necesario para cumplir con los propósitos descritos en esta política, a menos que la ley requiera o permita un período de retención más largo.
          </p>
        </div>

        <!-- Sección 8 -->
        <div class="mb-10">
          <h2 class="text-2xl font-bold text-gray-900 mb-6 pb-2 border-b border-gray-200">
            8. Enlaces a Sitios de Terceros
          </h2>
          <p class="text-gray-700">
            Nuestro sitio web puede contener enlaces a sitios de terceros. No somos responsables de las prácticas de privacidad de estos sitios. Le recomendamos revisar las políticas de privacidad de cualquier sitio que visite.
          </p>
        </div>

        <!-- Sección 9 -->
        <div class="mb-10">
          <h2 class="text-2xl font-bold text-gray-900 mb-6 pb-2 border-b border-gray-200">
            9. Cambios a Esta Política
          </h2>
          <p class="text-gray-700">
            Nos reservamos el derecho de actualizar esta Política de Privacidad en cualquier momento. Los cambios entrarán en vigor inmediatamente después de su publicación en nuestro sitio web. Le recomendamos revisar esta página periódicamente.
          </p>
        </div>

        <!-- Sección 10 -->
        <div class="mb-10">
          <h2 class="text-2xl font-bold text-gray-900 mb-6 pb-2 border-b border-gray-200">
            10. Contacto
          </h2>
          <p class="text-gray-700 mb-4">
            Si tiene preguntas o inquietudes sobre esta Política de Privacidad o sobre cómo manejamos su información personal, puede contactarnos:
          </p>
          <div class="bg-gray-50 rounded-lg p-6">
            <div class="space-y-4">
              <div class="flex items-center">
                <span class="text-blue-600 mr-3">✉️</span>
                <div>
                  <p class="font-semibold text-gray-900">Correo electrónico</p>
                  <a href="mailto:contacto@tsgroup.pe" class="text-blue-600 hover:text-blue-800 transition-colors">
                    contacto@tsgroup.pe
                  </a>
                </div>
              </div>
              <div class="flex items-center">
                <span class="text-blue-600 mr-3">📍</span>
                <div>
                  <p class="font-semibold text-gray-900">Dirección</p>
                  <p class="text-gray-700">Lima, Perú</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Descargo final -->
        <div class="mt-12 pt-8 border-t border-gray-200">
          <div class="bg-yellow-50 border border-yellow-100 rounded-lg p-5">
            <div class="flex items-start">
              <span class="text-yellow-600 text-xl mr-3">ℹ️</span>
              <div>
                <h4 class="font-bold text-gray-900 mb-2">Aviso Legal</h4>
                <p class="text-gray-700 text-sm">
                  Esta Política de Privacidad está diseñada para cumplir con las regulaciones peruanas de protección de datos personales (Ley N° 29733). Para solicitudes específicas sobre sus datos personales, contacte directamente a nuestro Oficial de Protección de Datos.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
    /* Animaciones suaves */
    h2 {
      position: relative;
    }
    
    h2::after {
      content: '';
      position: absolute;
      left: 0;
      bottom: -2px;
      width: 60px;
      height: 3px;
      background: linear-gradient(90deg, #3b82f6, #1d4ed8);
      border-radius: 2px;
    }
    
    /* Mejoras de accesibilidad */
    @media (prefers-reduced-motion: reduce) {
      * {
        animation: none !important;
        transition: none !important;
      }
    }
    
    /* Print styles */
    @media print {
      .bg-gray-50 { background-color: #fff !important; }
      .shadow-xl { box-shadow: none !important; }
      .rounded-2xl { border-radius: 0 !important; }
      .p-6 { padding: 0 !important; }
    }
  </style>
</Layout>