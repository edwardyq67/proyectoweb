---
import Layout from "../layouts/Layout.astro";
import BlogData from "../lib/Blog.json";
import { Icon } from "astro-icon/components";
import "../styles/global.css";
import Productos from "../components/Productos";

// Obtener artículos destacados
const articulosDestacados = BlogData.articulos.filter(
  (articulo) => articulo.destacado,
);

---

<Layout title="Blog - Aire Acondicionado y Ventilación">
  <!-- Hero Section -->
  <section
    class="relative py-20 lg:py-28 bg-gradient-to-br from-primary-50 via-white to-blue-50 overflow-hidden"
  >
    <!-- Elementos decorativos -->
    <div
      class="absolute top-10 left-10 w-72 h-72 bg-primary-100 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-pulse"
    >
    </div>
    <div
      class="absolute bottom-10 right-10 w-72 h-72 bg-blue-100 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-pulse"
      style="animation-delay: 2s;"
    >
    </div>

    <div class="container relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <h1
          class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 mb-6"
        >
          <span class="block">Expertos en</span>
          <span
            class="text-primary bg-gradient-to-r from-primary to-blue-600 bg-clip-text text-transparent"
          >
            Climatización
          </span>
        </h1>

        <p
          class="text-xl text-gray-600 mb-10 max-w-2xl mx-auto leading-relaxed"
        >
          Artículos técnicos, guías de mantenimiento y las últimas tendencias en
          aire acondicionado y ventilación mecánica.
        </p>

        <!-- Stats -->
        <div class="flex flex-wrap justify-center gap-8 mb-12">
          <div class="text-center">
            <div class="text-3xl font-bold text-primary mb-2">
              {BlogData.metadata.total_articulos}+
            </div>
            <div class="text-gray-600">Artículos Técnicos</div>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold text-primary mb-2">
              {BlogData.categorias.length}
            </div>
            <div class="text-gray-600">Categorías</div>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold text-primary mb-2">
              24/7
            </div>
            <div class="text-gray-600">Soporte Disponible</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Categorías -->
  <section class="py-16 bg-white">
    <div class="container">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          Explora por Categoría
        </h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          Encuentra contenido especializado según tus intereses
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {
          BlogData.categorias.map((categoria) => (
            <a
              href='#Productos'
              class="group relative bg-white rounded-2xl p-6 border border-gray-200 hover:border-primary/30 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1"
            >
              <div
                class={`w-12 h-12 ${categoria.color} rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform duration-300`}
              >
                <Icon name={categoria.icono} class="w-6 h-6 text-white" />
              </div>

              <h3 class="text-xl font-semibold text-gray-900 mb-2 group-hover:text-primary transition-colors">
                {categoria.nombre}
              </h3>

              <p class="text-gray-600 text-sm mb-4">{categoria.descripcion}</p>

              <div class="flex items-center text-primary font-medium text-sm">
                <span>{categoria.total_articulos} artículos</span>
                <Icon
                  name="mdi:arrow-right"
                  class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform"
                />
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Artículos Destacados -->
  <section class="py-20 bg-gray-50">
    <div class="container">
      <div
        class="flex flex-col lg:flex-row justify-between items-start lg:items-center mb-12"
      >
        <div>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
            Artículos Destacados
          </h2>
          <p class="text-lg text-gray-600 max-w-2xl">
            Lo más relevante sobre climatización y ventilación
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          articulosDestacados.map((articulo) => {
            return (
              <article class="cursor-pointer group bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-500 transform hover:-translate-y-2">
                <div class="relative h-64 md:h-72 overflow-hidden">
                  <img
                    src={articulo.img_principal}
                    alt={articulo.titulo}
                    class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700"
                  />
                </div>
                <div class="p-6">
                  <h3 class="text-2xl font-bold text-gray-900 mb-4 group-hover:text-primary transition-colors">
                    <a >{articulo.titulo}</a>
                  </h3>

                  <p class="text-gray-600 mb-6 leading-relaxed">
                    {articulo.descripcion_corta}
                  </p>
                  {articulo.tags.map((tag) => (
                    <span class="cursor-pointer inline-block bg-primary/10 text-primary px-4 py-2 rounded-full text-sm font-medium mr-2 mb-2">
                      {tag}
                    </span>
                  ))}
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>


  <Productos client:only="react" />
</Layout>

<style>
  /* Utilidades */
  .line-clamp-2 {
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .line-clamp-3 {
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  /* Animaciones personalizadas */
  .animate-float-delay {
    animation: float 3s ease-in-out infinite;
    animation-delay: var(--delay, 0s);
  }
</style>
