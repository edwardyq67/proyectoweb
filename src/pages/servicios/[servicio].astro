---
import Layout from '../../layouts/Layout.astro';
import serviciosData from '../../lib/Nosotros.json';
import { Icon } from 'astro-icon/components';
import "../../styles/global.css";
import Productos from '../../components/Productos';

// Exportar getStaticPaths para rutas dinámicas
export async function getStaticPaths() {
  return serviciosData.servicios.map((servicio) => ({
    params: {
      servicio: servicio.slug
    }
  }));
}

// Obtener el parámetro de la URL
const { servicio } = Astro.params;

// Buscar el servicio por slug
const servicioEncontrado = serviciosData.servicios.find(
  s => s.slug === servicio
);

// Si no existe el servicio, redirigir a 404
if (!servicioEncontrado) {
  return Astro.redirect('/404');
}
---

<Layout title={servicioEncontrado.titulo}>
  <!-- Hero Section con foto y título superpuesto -->
  <section class="relative min-h-[60vh] flex items-center justify-center overflow-hidden">
    <!-- Fondo con imagen -->
    <div 
      class="absolute inset-0 z-0"
      style={`
        background-image: url('${servicioEncontrado.img}');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
      `}
    >
      <!-- Overlay negro al 70% -->
      <div class="absolute inset-0 bg-black/70"></div>
    </div>
    
    <!-- Título centrado sobre la imagen -->
    <div class="container relative z-10 text-center text-white px-4">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-black mb-6 tracking-tight">
        {servicioEncontrado.titulo}
      </h1>
      <p class="text-xl md:text-2xl text-white/90 max-w-4xl mx-auto">
        {servicioEncontrado.contenido}
      </p>
    </div>
  </section>

  <!-- Contenido principal -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="container">
      <div class="grid lg:grid-cols-2 gap-12 items-start">
        
        <!-- Descripción extendida -->
        <div>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
            Descripción del Servicio
          </h2>
          <p class="text-lg text-gray-600 mb-8 leading-relaxed">
            {servicioEncontrado.descripcion_larga}
          </p>
          
          <!-- Beneficios -->
          <div class="mb-10">
            <h3 class="text-2xl font-bold text-gray-900 mb-6">
              Beneficios Principales
            </h3>
            <div class="space-y-4">
              {servicioEncontrado.beneficios.map((beneficio, index) => (
                <div class="flex items-start gap-4 p-4 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors">
                  <div class="w-8 h-8 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0 mt-1">
                    <Icon name="mdi:check" class="w-5 h-5 text-primary" />
                  </div>
                  <span class="text-gray-700">{beneficio}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
        
        <!-- Características técnicas -->
        <div class="bg-gray-50 rounded-2xl p-8">
          <h3 class="text-2xl font-bold text-gray-900 mb-6">
            Características Técnicas
          </h3>
          <div class="space-y-4">
            {servicioEncontrado.caracteristicas.map((caracteristica, index) => (
              <div class="flex items-center gap-4 p-3 bg-white rounded-lg shadow-sm">
                <div class="w-10 h-10 rounded-full bg-primary/5 flex items-center justify-center flex-shrink-0">
                  <span class="text-primary font-bold">{index + 1}</span>
                </div>
                <span class="text-gray-700">{caracteristica}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PRODUCTOS ESPECÍFICOS DEL SERVICIO -->
  <Productos client:load servicioSlug={servicio} />

  <!-- CTA -->
  <section class="py-16 lg:py-24 bg-gradient-to-r from-primary to-primary/80 text-white">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">
          ¿Interesado en {servicioEncontrado.titulo}?
        </h2>
        <p class="text-lg mb-8 opacity-90">
          Contáctanos para una evaluación gratuita y cotización personalizada.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a 
            href="/contacto"
            class="inline-flex items-center justify-center px-8 py-4 bg-white text-primary font-semibold rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 hover:scale-105"
          >
            <Icon name="mdi:message-text" class="w-5 h-5 mr-2" />
            Solicitar cotización
          </a>
          <a 
            href="tel:+1234567890"
            class="inline-flex items-center justify-center px-8 py-4 bg-transparent border-2 border-white text-white font-semibold rounded-xl hover:bg-white/10 transition-all duration-300"
          >
            <Icon name="mdi:phone" class="w-5 h-5 mr-2" />
            Llamar ahora
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Otros servicios relacionados -->
  <section class="py-16 lg:py-24 bg-gray-50">
    <div class="container">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          Otros Servicios
        </h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          Descubre todos nuestros servicios especializados
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {serviciosData.servicios.filter(s => s.slug !== servicio).slice(0, 3).map((servicioRel, index) => (
          <a 
            href={servicioRel.url}
            class="group bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2"
          >
            <div class="relative h-48 overflow-hidden">
              <img 
                src={servicioRel.img}
                alt={servicioRel.titulo}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
              <div class="absolute bottom-4 left-4">
                <Icon name={servicioRel.icono} class="w-8 h-8 text-white" />
              </div>
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-gray-900 mb-2">
                {servicioRel.titulo}
              </h3>
              <p class="text-gray-600 text-sm mb-4">
                {servicioRel.contenido}
              </p>
              <div class="flex items-center text-primary font-semibold">
                <span>Ver más</span>
                <Icon name="mdi:arrow-right" class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" />
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>