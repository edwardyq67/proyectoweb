---
import Layout from '../../layouts/Layout.astro';
import serviciosData from '../../lib/Nosotros.json';
import { Icon } from 'astro-icon/components';
import "../../styles/global.css";
import Productos from '../../components/Productos';
import Carrusel from '../../components/Carrusel.astro';

export async function getStaticPaths() {
  return serviciosData.servicios.map((servicio) => ({
    params: {
      servicio: servicio.slug
    }
  }));
}

const { servicio } = Astro.params;
const servicioEncontrado = serviciosData.servicios.find(
  s => s.slug === servicio
);

if (!servicioEncontrado) {
  return Astro.redirect('/404');
}

const servicioSlugParaProductos = servicioEncontrado?.slug || null;
---

<Layout title={servicioEncontrado.titulo}>
  <!-- Hero Section -->
  <section class="relative py-16 min-h-[50vh] flex items-center justify-center overflow-hidden">
    <div 
      class="absolute inset-0 z-0"
      style={`
        background-image: url('${servicioEncontrado.img}');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
      `}
    >
      <div class="absolute inset-0 bg-black/70"></div>
    </div>
    
    <div class="container relative z-10 px-4">
  <div class="max-w-4xl mx-auto text-center">
    <h1 class="text-4xl md:text-5xl lg:text-6xl font-black text-white mb-6 leading-tight">
      {servicioEncontrado.titulo}
    </h1>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a 
        href="/#contacto"
        class="inline-flex items-center justify-center px-8 py-4 bg-primary hover:bg-primary/90 text-white font-semibold rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1"
      >
        <Icon name="mdi:calendar-check" class="w-5 h-5 mr-2" />
        Solicitar Cotización
      </a>
      
      {
        (servicioEncontrado.titulo === "Aire acondicionado y climatización" || 
         servicioEncontrado.titulo === "Refrigeración comercial e industrial") && (
          <a 
            href={`https://wa.me/51912909920?text=${encodeURIComponent(`Hola, quiero un asesoramiento para: ${servicioEncontrado.titulo}`)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center px-8 py-4 bg-green-600 hover:bg-green-700 text-white font-semibold rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1"
          >
            <Icon name="mdi:whatsapp" class="w-5 h-5 mr-2" />
            Asesoramiento por WhatsApp
          </a>
        )
      }
    </div>
  </div>
</div>
  </section>

  <!-- Sección de Descripción -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="container">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="relative">
<div class="relative rounded-2xl overflow-hidden shadow-2xl">
  <img 
    src={servicioEncontrado.img}
    alt={servicioEncontrado.titulo}
    class="w-full h-auto object-cover"
  />
</div>
          <div class="absolute -bottom-6 -right-6 w-48 h-48 bg-primary/5 rounded-full -z-10"></div>
        </div>

        <div>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
            {servicioEncontrado.titulo}
          </h2>
          <p class="text-lg text-gray-600 mb-6 leading-relaxed">
            {servicioEncontrado.descripcion_larga}
          </p>
          
          <div class="space-y-4 mt-8">
            <div class="flex items-start gap-4 p-4 bg-gray-50 rounded-xl hover:bg-gray-100 transition-colors">
              <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
                <Icon name="mdi:certificate" class="w-6 h-6 text-primary" />
              </div>
              <div>
                <h4 class="font-semibold text-gray-900 mb-1">Experiencia Certificada</h4>
                <p class="text-gray-600 text-sm">Equipo técnico especializado con certificaciones internacionales</p>
              </div>
            </div>
            
            <div class="flex items-start gap-4 p-4 bg-gray-50 rounded-xl hover:bg-gray-100 transition-colors">
              <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
                <Icon name="mdi:lightning-bolt" class="w-6 h-6 text-primary" />
              </div>
              <div>
                <h4 class="font-semibold text-gray-900 mb-1">Alta Eficiencia Energética</h4>
                <p class="text-gray-600 text-sm">Equipos que reducen hasta 40% el consumo eléctrico</p>
              </div>
            </div>
            
            <div class="flex items-start gap-4 p-4 bg-gray-50 rounded-xl hover:bg-gray-100 transition-colors">
              <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
                <Icon name="mdi:shield-check" class="w-6 h-6 text-primary" />
              </div>
              <div>
                <h4 class="font-semibold text-gray-900 mb-1">Garantía y Seguridad</h4>
                <p class="text-gray-600 text-sm">Instalaciones certificadas con garantía extendida</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
{Object.keys(servicioEncontrado.VentilacionClimatizacion).length > 0 && servicioEncontrado.VentilacionClimatizacion.servicios && (
    <section class="py-16 lg:py-24 bg-gradient-to-br from-primary-950 to-primary-950">
      <div class="container">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
            {servicioEncontrado.VentilacionClimatizacion.titulo}
          </h2>
          <p class="text-lg text-gray-300 max-w-3xl mx-auto">
            Sistemas especializados para calidad del aire y confort ambiental
          </p>
        </div>

        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div class="relative order-2 lg:order-1">
            <div class="relative rounded-2xl overflow-hidden shadow-2xl">
              <img 
                src={servicioEncontrado.VentilacionClimatizacion.img || servicioEncontrado.img}
                alt={servicioEncontrado.VentilacionClimatizacion.titulo}
                class="w-full h-auto object-cover"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-primary-600/20 to-transparent"></div>
            </div>
            <div class="absolute -top-6 -left-6 w-40 h-40 bg-primary-500/5 rounded-full -z-10"></div>
            <div class="absolute -bottom-6 -right-6 w-32 h-32 bg-primary/5 rounded-full -z-10"></div>
          </div>

          <!-- Contenido -->
          <div class="order-1 lg:order-2">
            
            <!-- Servicios de Ventilación -->
            <div class="grid grid-cols-2 gap-4 mb-8">
              {servicioEncontrado.VentilacionClimatizacion.servicios.map((servicioVent, index) => (
                <div class="bg-white p-5 rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-1 border border-gray-100">
                  <div class="w-12 h-12 rounded-xl bg-primary-100 flex items-center justify-center mb-3">
                    <Icon name={servicioVent.icono} class="w-6 h-6 text-primary-600" />
                  </div>
                  <h4 class="font-semibold text-gray-900 mb-2">
                    {servicioVent.nombre}
                  </h4>
                  <p class="text-gray-600 text-sm">
                    {servicioVent.descripcion}
                  </p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

<!-- SECCIÓN DE SECCIONES - CONTENIDO INFORMATIVO -->
{servicioEncontrado.secciones && servicioEncontrado.secciones.length > 0 && (
  <section class="py-16 lg:py-24 bg-white">
    <div class="container">
      <!-- Encabezado de la sección -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="inline-flex items-center gap-2 px-4 py-2 bg-primary-50 text-primary-700 rounded-full text-sm font-medium mb-4">
          <Icon name="mdi:chart-box" class="w-4 h-4" />
          Información Especializada
        </span>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-6">
          {servicioEncontrado.secciones[0].titulo}
        </h2>
        {servicioEncontrado.secciones[0].contenido && (
          <p class="text-lg md:text-xl text-gray-600 leading-relaxed">
            {servicioEncontrado.secciones[0].contenido}
          </p>
        )}
      </div>

      <!-- Contenido de la sección - Layout mejorado -->
      {servicioEncontrado.secciones[0].items && Array.isArray(servicioEncontrado.secciones[0].items) && 
       servicioEncontrado.secciones[0].items.length > 0 && (
        <div class="max-w-6xl mx-auto">
          <!-- Para 5 items, diseño especial -->
          {servicioEncontrado.secciones[0].items.length === 5 ? (
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">

              
              <!-- Items restantes (4 items) -->
              {servicioEncontrado.secciones[0].items.map((item, idx) => {
                // Función para determinar el ícono basado en el título
                const getIconName = (titulo:any) => {
                  if (!titulo) return "mdi:information";
                  if (titulo.includes("Salud") || titulo.includes("Hospitalario")) return "mdi:medical-bag";
                  if (titulo.includes("Farmacéutica")) return "mdi:pill";
                  if (titulo.includes("Alimentaria") || titulo.includes("Procesamiento")) return "mdi:food-apple";
                  if (titulo.includes("Corporativo") || titulo.includes("Comercial")) return "mdi:office-building";
                  if (titulo.includes("Residencial")) return "mdi:home";
                  if (titulo.includes("Retail")) return "mdi:store";
                  if (titulo.includes("Horeca")) return "mdi:chef-hat";
                  return "mdi:information";
                };
                
                return (
                  <div 
  class="bg-gradient-to-br from-primary-50 to-white border border-gray-100 rounded-xl p-6 hover:border-primary-200 hover:shadow-lg transition-all duration-300"
>
                    <div class="flex items-start gap-4">
                      <div class="flex-shrink-0 mt-1">
                        <div class="w-12 h-12 rounded-lg bg-primary-50 flex items-center justify-center">
                          <Icon 
                            name={getIconName(item?.titulo)}
                            class="w-6 h-6 text-primary-600" 
                          />
                        </div>
                      </div>
                      <div>
                        <h4 class="text-xl font-semibold text-gray-900 mb-2">
                          {item?.titulo || "Sector especializado"}
                        </h4>
                        <p class="text-gray-600">
                          {item?.descripcion || "Información especializada del sector"}
                        </p>
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
          ) : (
            <!-- Layout estándar para otros números de items -->
            <div class="grid grid-cols-1 lg:grid-cols-2  gap-6">
              {servicioEncontrado.secciones[0].items.map((item, idx) => {
                // Función para determinar el ícono basado en el título
                const getIconName = (titulo:any) => {
                  if (!titulo) return "mdi:information";
                  if (titulo.includes("Salud") || titulo.includes("Hospitalario")) return "mdi:hospital";
                  if (titulo.includes("Farmacéutica")) return "mdi:pill";
                  if (titulo.includes("Alimentaria") || titulo.includes("Procesamiento")) return "mdi:food";
                  if (titulo.includes("Corporativo") || titulo.includes("Comercial")) return "mdi:briefcase";
                  if (titulo.includes("Residencial")) return "mdi:home";
                  if (titulo.includes("Retail")) return "mdi:store";
                  if (titulo.includes("Horeca")) return "mdi:chef-hat";
                  return "mdi:information";
                };
                
                return (
                  <div 
                    class="flex flex-col cursor-pointer hover:border-primary-200 hover:shadow-lg transition-all duration-300 md:flex-row items-start gap-6 bg-gradient-to-br from-primary-50 to-white rounded-2xl p-8 md:p-10 border border-primary-100"
                  >
                    <!-- Icono -->
                    <div class="mb-4">
                      <div class="w-14 h-14 rounded-xl from-primary-50 to-primary-100 flex items-center justify-center group-hover:from-primary-100 group-hover:to-primary-200 transition-all duration-300">
                        <Icon 
                          name={getIconName(item?.titulo)}
                          class="w-7 h-7 text-primary-600" 
                        />
                      </div>
                    </div>
                    <div>
                      <!-- Contenido -->
                    <h3 class="text-xl font-semibold text-gray-900 mb-3 group-hover:text-primary-700 transition-colors">
                      {item?.titulo || "Sector especializado"}
                    </h3>
                    <p class="text-gray-600 text-sm leading-relaxed">
                      {item?.descripcion || "Información especializada del sector"}
                    </p>
                    </div>
                  </div>
                );
              })}
            </div>
          )}
        </div>
      )}
    </div>
  </section>
)}
{(servicioEncontrado.Domestico.length > 0 || 
  servicioEncontrado.Comercial.length > 0 || 
  servicioEncontrado.Industrial.length > 0) && ( 
  <Carrusel />
)}
 

{(servicioEncontrado.Domestico.length > 0 || 
  servicioEncontrado.Comercial.length > 0 || 
  servicioEncontrado.Industrial.length > 0) && (
  <Productos client:load servicioSlug={servicioSlugParaProductos} />
)}
  <!-- Otros servicios relacionados -->
  <section class="py-16 lg:py-24 bg-gray-50">
    <div class="container">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          Servicios Relacionados
        </h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          Soluciones completas para todas tus necesidades de climatización
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {serviciosData.servicios.filter(s => s.slug !== servicio).slice(0, 3).map((servicioRel, index) => (
          <a 
            href={servicioRel.url}
            class="group relative bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-2xl transition-all duration-500 transform hover:-translate-y-2"
          >
            <div class="relative h-48 overflow-hidden">
              <img 
                src={servicioRel.img}
                alt={servicioRel.titulo}
                class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent"></div>
              <div class="absolute top-4 left-4">
                <div class="w-12 h-12 rounded-xl bg-white/20 backdrop-blur-sm flex items-center justify-center">
                  <Icon name={servicioRel.icono} class="w-6 h-6 text-white" />
                </div>
              </div>
            </div>
            
            <div class="p-6">
              <h3 class="text-xl font-bold text-gray-900 mb-3 group-hover:text-primary transition-colors">
                {servicioRel.titulo}
              </h3>
              <p class="text-gray-600 text-sm mb-4 line-clamp-2">
                {servicioRel.contenido}
              </p>
              <div class="flex items-center justify-between">
                <span class="text-primary font-semibold group-hover:underline">
                  Ver detalles
                </span>
                <Icon name="mdi:arrow-right" class="w-5 h-5 text-primary transform group-hover:translate-x-2 transition-transform" />
              </div>
            </div>
            
            <div class="absolute inset-0 border-2 border-transparent group-hover:border-primary/20 rounded-2xl transition-all duration-300"></div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  img {
    transition: transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  @media (max-width: 768px) {
    .container {
      padding-left: 1rem;
      padding-right: 1rem;
    }
  }
</style>
<script>
// Script para manejar la navegación inteligente
document.addEventListener('DOMContentLoaded', function() {
  const cotizacionBtn = document.querySelector('a[href="/#contacto"]');
  
  if (cotizacionBtn) {
    cotizacionBtn.addEventListener('click', function(e) {
      // Si estamos en la página de inicio
      if (window.location.pathname === '/') {
        // Navegar al hash en la misma página
        e.preventDefault();
        const contactoSection = document.getElementById('contacto');
        if (contactoSection) {
          contactoSection.scrollIntoView({ behavior: 'smooth' });
        } else {
          // Si no existe la sección, redirigir con hash
          window.location.hash = 'contacto';
        }
      }
      // Si NO estamos en la página de inicio, el enlace normal funcionará
    });
  }
});
</script>