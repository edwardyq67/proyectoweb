---
import Layout from '../../layouts/Layout.astro';
import serviciosData from '../../lib/Nosotros.json';
import { Icon } from 'astro-icon/components';
import "../../styles/global.css";
import Productos from '../../components/Productos';
import Carrusel from '../../components/Carrusel.astro';

export async function getStaticPaths() {
  return serviciosData.servicios.map((servicio) => ({
    params: {
      servicio: servicio.slug
    }
  }));
}

const { servicio } = Astro.params;
const servicioEncontrado = serviciosData.servicios.find(
  s => s.slug === servicio
);

if (!servicioEncontrado) {
  return Astro.redirect('/404');
}

const servicioSlugParaProductos = servicioEncontrado?.slug || null;
---

<Layout title={servicioEncontrado.titulo}>
  <!-- Hero Section -->
  <section class="relative min-h-[70vh] flex items-center justify-center overflow-hidden">
    <div 
      class="absolute inset-0 z-0"
      style={`
        background-image: url('${servicioEncontrado.img}');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
      `}
    >
      <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/60 to-transparent"></div>
    </div>
    
    <div class="container relative z-10 px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-black text-white mb-6 leading-tight">
          {servicioEncontrado.titulo}
        </h1>
        <p class="text-xl md:text-2xl text-white/90 mb-8">
          {servicioEncontrado.contenido}
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a 
            href="/contacto"
            class="inline-flex items-center justify-center px-8 py-4 bg-primary hover:bg-primary/90 text-white font-semibold rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1"
          >
            <Icon name="mdi:calendar-check" class="w-5 h-5 mr-2" />
            Solicitar Cotización
          </a>
          <a 
            href="tel:+1234567890"
            class="inline-flex items-center justify-center px-8 py-4 bg-white/10 backdrop-blur-sm border border-white/20 text-white font-semibold rounded-xl hover:bg-white/20 transition-all duration-300"
          >
            <Icon name="mdi:phone" class="w-5 h-5 mr-2" />
            Llamar Ahora
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Sección de Descripción -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="container">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="relative">
          <div class="relative rounded-2xl overflow-hidden shadow-2xl">
            <img 
              src={servicioEncontrado.img}
              alt={servicioEncontrado.titulo}
              class="w-full h-[400px] object-cover transform hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-primary/20 to-transparent"></div>
          </div>
          <div class="absolute -bottom-6 -right-6 w-48 h-48 bg-primary/5 rounded-full -z-10"></div>
        </div>

        <div>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
            Soluciones Integrales de Climatización
          </h2>
          <p class="text-lg text-gray-600 mb-6 leading-relaxed">
            {servicioEncontrado.descripcion_larga}
          </p>
          
          <div class="space-y-4 mt-8">
            <div class="flex items-start gap-4 p-4 bg-gray-50 rounded-xl hover:bg-gray-100 transition-colors">
              <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
                <Icon name="mdi:certificate" class="w-6 h-6 text-primary" />
              </div>
              <div>
                <h4 class="font-semibold text-gray-900 mb-1">Experiencia Certificada</h4>
                <p class="text-gray-600 text-sm">Equipo técnico especializado con certificaciones internacionales</p>
              </div>
            </div>
            
            <div class="flex items-start gap-4 p-4 bg-gray-50 rounded-xl hover:bg-gray-100 transition-colors">
              <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
                <Icon name="mdi:lightning-bolt" class="w-6 h-6 text-primary" />
              </div>
              <div>
                <h4 class="font-semibold text-gray-900 mb-1">Alta Eficiencia Energética</h4>
                <p class="text-gray-600 text-sm">Equipos que reducen hasta 40% el consumo eléctrico</p>
              </div>
            </div>
            
            <div class="flex items-start gap-4 p-4 bg-gray-50 rounded-xl hover:bg-gray-100 transition-colors">
              <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
                <Icon name="mdi:shield-check" class="w-6 h-6 text-primary" />
              </div>
              <div>
                <h4 class="font-semibold text-gray-900 mb-1">Garantía y Seguridad</h4>
                <p class="text-gray-600 text-sm">Instalaciones certificadas con garantía extendida</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECCIÓN DE VENTILACIÓN Y CLIMATIZACIÓN - DISEÑO MEJORADO -->
  {Object.keys(servicioEncontrado.VentilacionClimatizacion).length > 0 && servicioEncontrado.VentilacionClimatizacion.servicios && (
    <section class="py-16 lg:py-24 bg-gradient-to-b from-blue-50 to-white">
      <div class="container">
        <div class="text-center mb-12">
          <div class="inline-flex items-center gap-3 mb-4">
            <div class="w-12 h-12 rounded-xl bg-blue-500 flex items-center justify-center">
              <Icon name="mdi:fan" class="w-7 h-7 text-white" />
            </div>
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900">
              {servicioEncontrado.VentilacionClimatizacion.titulo}
            </h2>
          </div>
          <p class="text-lg text-gray-600 max-w-3xl mx-auto">
            Soluciones especializadas en ventilación mecánica y calidad del aire interior
          </p>
        </div>

        <!-- Diseño tipo tabla/dashboard para servicios -->
        <div class="bg-white rounded-2xl shadow-xl border border-gray-100 overflow-hidden">
          <div class="p-6 border-b border-gray-100">
            <h3 class="text-xl font-semibold text-gray-900 mb-2">Nuestros Servicios de Ventilación</h3>
            <p class="text-gray-600">Equipos de alta eficiencia para cada necesidad específica</p>
          </div>
          
          <div class="divide-y divide-gray-100">
            {servicioEncontrado.VentilacionClimatizacion.servicios.map((servicioVent, index) => (
              <div class="p-6 hover:bg-blue-50/50 transition-colors duration-300">
                <div class="flex flex-col md:flex-row md:items-center gap-4">
                  <!-- Icono y número -->
                  <div class="flex items-center gap-4 md:w-1/4">
                    <div class="flex items-center justify-center">
                      <div class="relative">
                        <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-blue-500 to-blue-600 flex items-center justify-center">
                          <Icon name={servicioVent.icono} class="w-7 h-7 text-white" />
                        </div>
                        <div class="absolute -top-2 -right-2 w-8 h-8 bg-blue-400 text-white text-xs font-bold rounded-full flex items-center justify-center">
                          {index + 1}
                        </div>
                      </div>
                    </div>
                    <div class="md:hidden">
                      <h4 class="font-bold text-gray-900 text-lg">{servicioVent.nombre}</h4>
                    </div>
                  </div>
                  
                  <!-- Contenido -->
                  <div class="md:w-3/4">
                    <div class="hidden md:block mb-3">
                      <h4 class="font-bold text-gray-900 text-lg">{servicioVent.nombre}</h4>
                    </div>
                    <p class="text-gray-600 mb-4">{servicioVent.descripcion}</p>
                    
                    <!-- Características adicionales (ejemplo) -->
                    <div class="flex flex-wrap gap-2">
                      <span class="text-xs bg-blue-100 text-blue-800 px-3 py-1.5 rounded-full">Alta eficiencia</span>
                      <span class="text-xs bg-green-100 text-green-800 px-3 py-1.5 rounded-full">Bajo consumo</span>
                      <span class="text-xs bg-purple-100 text-purple-800 px-3 py-1.5 rounded-full">Instalación profesional</span>
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
          
          <!-- Footer de la tabla -->
          <div class="bg-gray-50 p-6 border-t border-gray-100">
            <div class="flex flex-col md:flex-row justify-between items-center gap-4">
              <p class="text-gray-600 text-sm">Todos nuestros equipos incluyen garantía y servicio técnico especializado</p>
              <a 
                href="/contacto" 
                class="inline-flex items-center gap-2 px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg transition-colors"
              >
                <Icon name="mdi:chat-processing" class="w-5 h-5" />
                Solicitar Asesoría Técnica
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- SECCIÓN DE SECCIONES - CONTENIDO INFORMATIVO -->
  {servicioEncontrado.secciones && servicioEncontrado.secciones.length > 0 && (
    <section class="py-16 lg:py-24 bg-gradient-to-b from-gray-50 to-white">
      <div class="container">
        <div class="text-center mb-12">
          <div class="inline-flex items-center gap-3 mb-4">
            <div class="w-12 h-12 rounded-xl bg-amber-500 flex items-center justify-center">
              <Icon name="mdi:book-information-variant" class="w-7 h-7 text-white" />
            </div>
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900">
              Información Especializada
            </h2>
          </div>
          <p class="text-lg text-gray-600 max-w-3xl mx-auto">
            Conoce nuestros procesos, metodologías y soluciones sectoriales
          </p>
        </div>

        <div class="space-y-8">
          {servicioEncontrado.secciones.map((seccion, index) => (
            <div 
              key={index}
              class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-lg hover:shadow-xl transition-all duration-300"
            >
              <!-- Encabezado de la sección -->
              <div class="bg-gradient-to-r from-gray-50 to-gray-100 p-8 border-b border-gray-200">
                <div class="flex items-center gap-4">
                  <div class="p-4 bg-amber-500 text-white rounded-xl">
                    <Icon 
                      name={seccion.titulo.includes("Sector") ? "mdi:account-group" : 
                            seccion.titulo.includes("Portafolio") ? "mdi:briefcase" :
                            seccion.titulo.includes("Metodología") ? "mdi:cogs" :
                            seccion.titulo.includes("Productos") ? "mdi:package-variant" :
                            "mdi:information"} 
                      class="w-8 h-8" 
                    />
                  </div>
                  <div>
                    <h3 class="text-2xl font-bold text-gray-900">{seccion.titulo}</h3>
                    {seccion.contenido && (
                      <p class="text-gray-600 mt-2 max-w-3xl">{seccion.contenido}</p>
                    )}
                  </div>
                </div>
              </div>
              
              <!-- Contenido de la sección -->
              <div class="p-8">
                {/* Para items con estructura de objeto */}
                {seccion.items && Array.isArray(seccion.items) && seccion.items.length > 0 && typeof seccion.items[0] === 'object' ? (
                  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    {seccion.items.map((item, idx) => (
                      <div 
                        key={idx}
                        class="bg-gradient-to-br from-gray-50 to-white border border-gray-100 rounded-xl p-6 hover:shadow-md transition-all duration-300 hover:-translate-y-1"
                      >
                        <div class="flex items-start gap-3 mb-4">
                          <div class="p-2 bg-amber-100 text-amber-600 rounded-lg mt-1">
                            <Icon 
                              name={item.titulo.includes("Salud") ? "mdi:hospital" :
                                    item.titulo.includes("Farmacéutica") ? "mdi:pill" :
                                    item.titulo.includes("Alimentaria") ? "mdi:food" :
                                    item.titulo.includes("Corporativo") ? "mdi:office-building" :
                                    "mdi:home"}
                              class="w-6 h-6"
                            />
                          </div>
                          <h4 class="font-bold text-gray-900 text-lg">{item.titulo}</h4>
                        </div>
                        <p class="text-gray-600 leading-relaxed">{item.descripcion}</p>
                      </div>
                    ))}
                  </div>
                ) : seccion.items && Array.isArray(seccion.items) && seccion.items.length > 0 ? (
                  /* Para items como strings */
                  <div class="space-y-4">
                    {seccion.items.map((item, idx) => (
                      <div 
                        key={idx}
                        class="flex items-start gap-4 p-5 bg-gray-50 rounded-xl hover:bg-gray-100 transition-colors duration-300"
                      >
                        <div class="p-2 bg-amber-500 text-white rounded-lg mt-1 flex-shrink-0">
                          <Icon name="mdi:check-circle" class="w-5 h-5" />
                        </div>
                        <p class="text-gray-700 leading-relaxed">{item}</p>
                      </div>
                    ))}
                  </div>
                ) : seccion.contenido && !seccion.items ? (
                  /* Para contenido simple sin items */
                  <div class="bg-blue-50 border-l-4 border-blue-500 p-6 rounded-r-lg">
                    <div class="flex items-center gap-3 mb-4">
                      <Icon name="mdi:lightbulb-on" class="w-6 h-6 text-blue-600" />
                      <h4 class="font-bold text-gray-900">Información Destacada</h4>
                    </div>
                    <p class="text-gray-700 text-lg leading-relaxed">{seccion.contenido}</p>
                  </div>
                ) : null}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}
  
  <!-- Carrusel de Marcas -->
  {servicioEncontrado.marcas && (
    <Carrusel marcas={servicioEncontrado.marcas} />
  )}
 
  <Productos client:load servicioSlug={servicioSlugParaProductos} />

  <!-- Otros servicios relacionados -->
  <section class="py-16 lg:py-24 bg-gray-50">
    <div class="container">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          Servicios Relacionados
        </h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          Soluciones completas para todas tus necesidades de climatización
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {serviciosData.servicios.filter(s => s.slug !== servicio).slice(0, 3).map((servicioRel, index) => (
          <a 
            href={servicioRel.url}
            class="group relative bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-2xl transition-all duration-500 transform hover:-translate-y-2"
          >
            <div class="relative h-48 overflow-hidden">
              <img 
                src={servicioRel.img}
                alt={servicioRel.titulo}
                class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent"></div>
              <div class="absolute top-4 left-4">
                <div class="w-12 h-12 rounded-xl bg-white/20 backdrop-blur-sm flex items-center justify-center">
                  <Icon name={servicioRel.icono} class="w-6 h-6 text-white" />
                </div>
              </div>
            </div>
            
            <div class="p-6">
              <h3 class="text-xl font-bold text-gray-900 mb-3 group-hover:text-primary transition-colors">
                {servicioRel.titulo}
              </h3>
              <p class="text-gray-600 text-sm mb-4 line-clamp-2">
                {servicioRel.contenido}
              </p>
              <div class="flex items-center justify-between">
                <span class="text-primary font-semibold group-hover:underline">
                  Ver detalles
                </span>
                <Icon name="mdi:arrow-right" class="w-5 h-5 text-primary transform group-hover:translate-x-2 transition-transform" />
              </div>
            </div>
            
            <div class="absolute inset-0 border-2 border-transparent group-hover:border-primary/20 rounded-2xl transition-all duration-300"></div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  img {
    transition: transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  @media (max-width: 768px) {
    .container {
      padding-left: 1rem;
      padding-right: 1rem;
    }
  }
</style>