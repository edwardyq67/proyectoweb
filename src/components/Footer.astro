---
import { Icon } from "astro-icon/components";
import datosNosotros from "../lib/Nosotros.json";
---

<footer class="bg-gray-900 text-white pt-12 pb-8">
    <div class="container">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-12">
            <!-- Columna 1: Logo y descripción -->
            <div>
                <div class="flex items-center gap-3 mb-6">
                    <svg
                        class="h-10 w-10 text-primary"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                        ></path>
                    </svg>
                    <span class="text-2xl font-bold">MiEmpresa</span>
                </div>
                <p class="text-gray-400 mb-6">
                    Especialistas en sistemas de climatización y ventilación
                    industrial. Soluciones HVAC de alta calidad desde 2010.
                </p>

                <!-- Redes Sociales -->
                <div class="flex gap-4">
                    <a
                        href="https://facebook.com"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="w-10 h-10 rounded-full bg-gray-800 flex items-center justify-center hover:bg-blue-600 transition-colors"
                        aria-label="Facebook"
                    >
                        <Icon name="mdi:facebook" class="w-5 h-5" />
                    </a>
                    <a
                        href="https://instagram.com"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="w-10 h-10 rounded-full bg-gray-800 flex items-center justify-center hover:bg-pink-600 transition-colors"
                        aria-label="Instagram"
                    >
                        <Icon name="mdi:instagram" class="w-5 h-5" />
                    </a>
                    <a
                        href="https://twitter.com"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="w-10 h-10 rounded-full bg-gray-800 flex items-center justify-center hover:bg-blue-400 transition-colors"
                        aria-label="Twitter"
                    >
                        <Icon name="mdi:twitter" class="w-5 h-5" />
                    </a>
                    <a
                        href="https://api.whatsapp.com/send?phone=1234567890&text=Hola,%20me%20gustaría%20más%20información"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="w-10 h-10 rounded-full bg-green-600 flex items-center justify-center hover:bg-green-700 transition-colors"
                        aria-label="WhatsApp"
                    >
                        <Icon name="mdi:whatsapp" class="w-5 h-5" />
                    </a>
                </div>
            </div>

            <!-- Columna 2: Servicios usando .map() -->
            <div>
                <h3 class="text-lg font-semibold mb-6">Servicios</h3>
                <ul class="space-y-3">
                    {
                        datosNosotros.servicios
                            .slice(0, 6)
                            .map((servicio, index) => {
                                // Mapeo de iconos por tipo de servicio
                                const iconMap = {
                                    "Mantenimiento Preventivo":
                                        "mdi:check-circle-outline",
                                    "Instalación de Sistemas": "mdi:tools",
                                    "Reparación Especializada": "mdi:wrench",
                                    "Ductos y Ventilación": "mdi:air-filter",
                                    "Control de Calidad": "mdi:shield-check",
                                    "Consultoría HVAC": "mdi:account-tie",
                                };

                                const iconName =
                                    iconMap[
                                        servicio.titulo as keyof typeof iconMap
                                    ] || "mdi:cog";
                                return (
                                    <li>
                                        <a
                                            href={servicio.url || "#"}
                                            class="text-gray-400 hover:text-primary transition-colors flex items-center gap-2"
                                        >
                                            <Icon
                                                name={iconName}
                                                class="w-4 h-4"
                                            />
                                            {servicio.titulo}
                                        </a>
                                    </li>
                                );
                            })
                    }
                </ul>
            </div>

            <!-- Columna 3: Contacto -->
            <div>
                <h3 class="text-lg font-semibold mb-6">Contacto</h3>
                <ul class="space-y-4">
                    <li class="flex items-start gap-3">
                        <Icon
                            name="mdi:map-marker"
                            class="w-5 h-5 text-primary mt-0.5 flex-shrink-0"
                        />
                        <span class="text-gray-400">
                            Av. Principal 1234<br />
                            Ciudad, País
                        </span>
                    </li>
                    <li class="flex items-center gap-3">
                        <Icon
                            name="mdi:phone"
                            class="w-5 h-5 text-primary flex-shrink-0"
                        />
                        <a
                            href="tel:+1234567890"
                            class="text-gray-400 hover:text-primary transition-colors"
                        >
                            +1 (234) 567-890
                        </a>
                    </li>
                    <li class="flex items-center gap-3">
                        <Icon
                            name="mdi:email"
                            class="w-5 h-5 text-primary flex-shrink-0"
                        />
                        <a
                            href="mailto:info@miempresa.com"
                            class="text-gray-400 hover:text-primary transition-colors"
                        >
                            info@miempresa.com
                        </a>
                    </li>
                    <li class="flex items-center gap-3">
                        <Icon
                            name="mdi:whatsapp"
                            class="w-5 h-5 text-green-500 flex-shrink-0"
                        />
                        <a
                            href="https://api.whatsapp.com/send?phone=1234567890&text=Hola,%20me%20gustaría%20más%20información"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-green-400 hover:text-green-300 transition-colors font-medium"
                        >
                            WhatsApp: +1 (234) 567-890
                        </a>
                    </li>
                </ul>

                <!-- Horario de atención -->
                <div class="mt-6 pt-6 border-t border-gray-800">
                    <h4 class="text-sm font-semibold mb-2">
                        Horario de Atención
                    </h4>
                    <p class="text-gray-400 text-sm">
                        Lunes a Viernes: 8:00 AM - 6:00 PM<br />
                        Sábados: 9:00 AM - 1:00 PM
                    </p>
                </div>
            </div>

            <!-- Columna 4: Newsletter -->
            <div>
                <h3 class="text-lg font-semibold mb-6">Newsletter</h3>
                <p class="text-gray-400 mb-4">
                    Suscríbete para recibir ofertas especiales y noticias sobre
                    climatización.
                </p>
                <form class="space-y-3">
                    <input
                        type="email"
                        placeholder="Tu correo electrónico"
                        class="w-full px-4 py-3 rounded-lg bg-gray-800 border border-gray-700 text-white placeholder-gray-500 focus:outline-none focus:border-primary transition-colors"
                        required
                    />
                    <button
                        type="submit"
                        class="w-full bg-primary hover:bg-primary/90 text-white font-medium py-3 px-4 rounded-lg transition-colors flex items-center justify-center gap-2"
                    >
                        <Icon name="mdi:send" class="w-4 h-4" />
                        Suscribirse
                    </button>
                </form>

                <!-- Logros usando .map() -->
                <div class="mt-8 pt-6 border-t border-gray-800">
                    <h4 class="text-sm font-semibold mb-4">Nuestros Logros</h4>
                    <ul class="space-y-2">
                        {
                            datosNosotros.logros
                                .slice(0, 3)
                                .map((logro, index) => (
                                    <li class="flex items-start gap-2">
                                        <Icon
                                            name="mdi:check-circle"
                                            class="w-4 h-4 text-green-500 mt-0.5 flex-shrink-0"
                                        />
                                        <span class="text-gray-400 text-sm">
                                            {logro}
                                        </span>
                                    </li>
                                ))
                        }
                    </ul>
                </div>
            </div>
        </div>

        <!-- Línea divisoria -->
        <div class="border-t border-gray-800 pt-8">
            <div
                class="flex flex-col md:flex-row justify-between items-center gap-4"
            >
                <!-- Copyright -->
                <div class="text-gray-500 text-sm">
                    &copy; {new Date().getFullYear()} MiEmpresa. Todos los derechos
                    reservados.
                </div>

                <!-- Enlaces legales -->
                <div class="flex flex-wrap gap-6">
                    <a
                        href="/privacidad"
                        class="text-gray-400 hover:text-primary transition-colors text-sm"
                    >
                        Política de Privacidad
                    </a>
                    <a
                        href="/terminos"
                        class="text-gray-400 hover:text-primary transition-colors text-sm"
                    >
                        Términos de Servicio
                    </a>
                    <a
                        href="/cookies"
                        class="text-gray-400 hover:text-primary transition-colors text-sm"
                    >
                        Cookies
                    </a>
                    <a
                        href="/sitemap.xml"
                        class="text-gray-400 hover:text-primary transition-colors text-sm"
                    >
                        Mapa del Sitio
                    </a>
                </div>
            </div>
        </div>
    </div>
</footer>

<!-- Botón flotante de WhatsApp -->
<a
    href="https://api.whatsapp.com/send?phone=1234567890&text=Hola,%20me%20gustaría%20más%20información"
    target="_blank"
    rel="noopener noreferrer"
    class="fixed bottom-6 right-6 z-50 bg-green-500 hover:bg-green-600 text-white p-4 rounded-full shadow-xl transition-all duration-300 hover:scale-110 hover:shadow-2xl group"
    aria-label="Contactar por WhatsApp"
>
    <Icon name="mdi:whatsapp" class="w-7 h-7" />
    <div
        class="absolute flex flex-col right-full mr-3 top-1/2 -translate-y-1/2 bg-gray-900 text-white px-3 py-2 rounded-lg text-sm whitespace-nowrap opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all"
    >
        <span>¿Necesitas ayuda? </span>
        <span>992188849</span>
    </div>
</a>
