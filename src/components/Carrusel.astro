---
// Carrusel.astro
interface Props {
  marcas?: Array<{
    id: number;
    nombre: string;
    logo: string;
    slug: string;
    descripcion: string;
  }>;
  metadata?: {
    titulo?: string;
    descripcion?: string;
  };
}

const { marcas = [], metadata = {} } = Astro.props;

// Configuración por defecto
const defaultMetadata = {
  titulo: "Trabajamos con las Mejores Marcas",
  descripcion: "Equipos de calidad garantizada para cada proyecto"
};

const config = {
  ...defaultMetadata,
  ...metadata
};

// Si no hay marcas en las props, usar las del archivo JSON
let marcasAMostrar = marcas;

// Solo mostrar la sección si hay marcas
const mostrarSeccion = marcasAMostrar && marcasAMostrar.length > 0;
---

{mostrarSeccion && (
  <!-- Carrusel de Marcas -->
  <section class="pb-16 bg-gray-50">
    <div class="container">
      
      <!-- Contenedor del carrusel -->
      <div class="relative overflow-hidden py-4">
        <!-- Overlay izquierdo para degradado -->
        <div class="absolute left-0 top-0 bottom-0 w-24 bg-gradient-to-r from-gray-50 to-transparent z-10 pointer-events-none"></div>
        
        <!-- Carrusel infinito -->
        <div class="flex animate-scroll">
          {marcasAMostrar.map((marca) => (
            <div 
              class="flex-shrink-0 mx-6 bg-white rounded-xl shadow-sm flex items-center justify-center p-6 border border-gray-100 hover:shadow-md hover:border-primary/20 transition-all duration-300"
            >
              <img 
                src={marca.logo} 
                alt={marca.nombre}
                class="max-w-full max-h-full object-contain hover:grayscale-0 transition-all duration-300"
                title={marca.nombre}
                loading="lazy"
                width="300"
                height="60"
              />
            </div>
          ))}
          <!-- Duplicar las marcas para efecto infinito continuo -->
          {marcasAMostrar.map((marca) => (
            <div 
              class="flex-shrink-0 mx-6 bg-white rounded-xl shadow-sm flex items-center justify-center p-6 border border-gray-100 hover:shadow-md hover:border-primary/20 transition-all duration-300"
              aria-hidden="true"
            >
              <img 
                src={marca.logo} 
                alt={`${marca.nombre} (duplicado)`}
                class="max-w-full max-h-full object-contain hover:grayscale-0 transition-all duration-300"
                title={marca.nombre}
                loading="lazy"
                width="300"
                height="60"
              />
            </div>
          ))}
        </div>
        
        <!-- Overlay derecho para degradado -->
        <div class="absolute right-0 top-0 bottom-0 w-24 bg-gradient-to-l from-gray-50 to-transparent z-10 pointer-events-none"></div>
      </div>
    </div>
  </section>
)}

{mostrarSeccion && (
  <style>
    @keyframes scroll {
      0% {
        transform: translateX(0);
      }
      100% {
        transform: translateX(calc(-100% / 2));
      }
    }
    
    .animate-scroll {
      display: flex;
      width: max-content;
      animation: scroll 40s linear infinite;
    }
    
    /* Pausar animación al hacer hover */
    .animate-scroll:hover {
      animation-play-state: paused;
    }
    
    /* Responsive */
    @media (max-width: 768px) {
      .animate-scroll {
        animation: scroll 30s linear infinite;
      }
      
      .animate-scroll > div {
        width: 140px;
        margin-left: 1.5rem;
        margin-right: 1.5rem;
        height: 100px;
      }
    }
  </style>
)}