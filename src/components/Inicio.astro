---
import Layout from '../layouts/Layout.astro';
import datosInicio from '../lib/Inicio.json';
---

<section id="Inicio" class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Fondo con imagen del JSON - Optimizado para móvil -->
  <div 
    class="absolute inset-0 z-0" 
    style={`
      background-image: url('${datosInicio.fondo}');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    `}
  >
    <!-- Overlay adaptable por dispositivo -->
    <div class="absolute inset-0 bg-black/70 md:bg-black/60"></div>
  </div>
  
  <div class="container relative z-10 text-center text-white px-4 py-8 md:py-16 lg:py-20">
    <!-- Título principal - Responsive -->
    <h1 
      class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl xl:text-8xl font-black mb-6 md:mb-8 tracking-tight opacity-0 animate-[fade-in-up_1s_ease-out_0.3s_forwards]"
      style="transform: translateY(30px); text-shadow: 0 10px 30px rgba(0,0,0,0.3);"
    >
      <span class="bg-primary from-white via-primary/30 to-white bg-clip-text text-transparent animate-background-shine">
        {datosInicio.titulo}
      </span>
    </h1>
    
    <!-- Subtítulo - Mejor responsive -->
    <p 
      class="text-lg sm:text-xl md:text-2xl lg:text-3xl mb-8 md:mb-12 max-w-4xl mx-auto font-light leading-relaxed px-2 sm:px-4 opacity-0 animate-[fade-in_1.2s_ease-out_0.8s_forwards]"
      style="text-shadow: 0 2px 10px rgba(0,0,0,0.2);"
    >
      {datosInicio.subtitulo}
    </p>
    
    <!-- Botones - Mejor distribución en móvil -->
    <div class="flex flex-col sm:flex-row gap-4 sm:gap-6 justify-center items-center animate-[fade-in-up_0.8s_ease-out_1s_forwards] opacity-0 px-2 sm:px-0">
      <!-- Botón principal - Tamaño responsive -->
      <a 
        href={datosInicio.botones.contacto.enlace}
        class="group relative w-full sm:w-auto px-6 sm:px-8 md:px-12 py-4 md:py-5 bg-gradient-to-br from-white to-gray-100 text-primary font-bold text-lg sm:text-xl rounded-xl sm:rounded-2xl shadow-xl sm:shadow-2xl hover:shadow-3xl transition-all duration-300 transform hover:-translate-y-1 hover:scale-105 active:scale-95"
      >
        <span class="relative z-10 flex items-center justify-center gap-2 sm:gap-3">
          {datosInicio.botones.contacto.texto}
          <span class="group-hover:translate-x-2 transition-transform duration-300">→</span>
        </span>
        <div class="absolute inset-0 bg-gradient-to-br from-primary/10 to-transparent opacity-0 group-hover:opacity-100 rounded-xl sm:rounded-2xl transition-opacity duration-300"></div>
      </a>
      
      <!-- Botón secundario - Tamaño responsive -->
      <a 
        href={datosInicio.botones.servicios.enlace}
        class="group relative w-full sm:w-auto px-6 sm:px-8 md:px-12 py-4 md:py-5 backdrop-blur-md bg-white/10 border-2 border-white/30 text-white font-bold text-lg sm:text-xl rounded-xl sm:rounded-2xl shadow-lg sm:shadow-xl hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-1 hover:scale-105 active:scale-95 hover:bg-white/20 hover:border-white/50"
      >
        <span class="relative z-10 flex items-center justify-center gap-2 sm:gap-3">
          {datosInicio.botones.servicios.texto}
          <span class="group-hover:rotate-90 transition-transform duration-300">+</span>
        </span>
      </a>
    </div>
    
    <!-- Estadísticas - Mejor responsive -->
    <div class="mt-10 sm:mt-14 md:mt-16 flex flex-wrap justify-center gap-4 sm:gap-6 md:gap-8 opacity-0 animate-[fade-in_1s_ease-out_1.5s_forwards]">
      <div class="text-center  sm:min-w-0 px-2">
        <div class="text-2xl sm:text-3xl font-bold mb-1 animate-pulse">500+</div>
        <div class="text-xs sm:text-sm text-white/70">Clientes Satisfechos</div>
      </div>
      <div class="text-center  sm:min-w-0 px-2">
        <div class="text-2xl sm:text-3xl font-bold mb-1 animate-pulse" style="animation-delay: 0.2s">100%</div>
        <div class="text-xs sm:text-sm text-white/70">Tasa de Éxito</div>
      </div>
      <div class="text-center  sm:min-w-0 px-2">
        <div class="text-2xl sm:text-3xl font-bold mb-1 animate-pulse" style="animation-delay: 0.4s">24/7</div>
        <div class="text-xs sm:text-sm text-white/70">Soporte Disponible</div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Animación personalizada para el fondo */
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  
  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  @keyframes fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  
  section:first-child > div:first-child {
    animation: fadeIn 1s ease-out;
  }
  
  /* Mejorar animación shine en móvil */
  @keyframes background-shine {
    0% {
      background-position: -200% center;
    }
    100% {
      background-position: 200% center;
    }
  }
  
  .animate-background-shine {
    background-size: 200% auto;
    animation: background-shine 3s ease-in-out infinite;
  }
  
  /* Optimizar para móviles pequeños */
  @media (max-width: 380px) {
    h1 {
      font-size: 2.5rem !important;
    }
    p {
      font-size: 1rem !important;
      padding: 0 0.5rem !important;
    }
    .container {
      padding-left: 1rem !important;
      padding-right: 1rem !important;
    }
  }
</style>