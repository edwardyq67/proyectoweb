---
import Layout from '../layouts/Layout.astro';
import datosProductos from '../lib/Productos.json';


declare global {
  interface Window {
    irASlide: (index: number) => void;
    abrirModalProducto: (index: number) => void;
  }
}
---

<Layout title="Productos">
  <section id="Productos" class="py-20 bg-gray-50">
    <div class="container">
      <h1 class="text-4xl md:text-5xl font-bold text-primary text-center mb-4 animate-fade-in">
        Nuestros Productos
      </h1>
      <p class="text-lg text-gray-600 text-center mb-12 max-w-3xl mx-auto animate-fade-in">
        Descubre nuestra línea completa de sistemas Fancoil para climatización residencial, comercial e industrial.
      </p>
      
      <div class="relative overflow-hidden group">
        <div 
          id="productos-carrusel" 
          class="flex transition-transform duration-500 ease-out cursor-grab active:cursor-grabbing select-none py-4"
          style="touch-action: pan-y;"
          data-productos={JSON.stringify(datosProductos.productos)}
        >
          {datosProductos.productos.map((producto, index) => (
            <div 
              class="min-w-full md:min-w-[50%] lg:min-w-[33.333%] xl:min-w-[25%] p-4 draggable-slide transition-all duration-500 ease-out"
              draggable="false"
              data-index={index}
              style={`animation: slide-up-fade 0.7s ease-out ${0.2 + index * 0.1}s forwards; opacity: 0;`}
            >
              <div class="bg-white rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-500 ease-out overflow-hidden border border-gray-100 h-full group/card">
                <div class="h-64 overflow-hidden relative">
                  <div class="absolute inset-0 bg-gradient-to-t from-black/5 via-transparent to-transparent z-10"></div>
                  <img 
                    src={producto.img}
                    alt={producto.titulo}
                    class="w-full h-full object-cover transition-all duration-700 ease-[cubic-bezier(0.22,0.61,0.36,1)] group-hover/card:scale-[1.05]"
                    loading="lazy"
                    draggable="false"
                    style="will-change: transform;"
                  />
                </div>
                
                <div class="p-6">
                  <h3 class="text-xl font-bold text-primary mb-2 transform group-hover/card:translate-x-1 transition-transform duration-300">
                    {producto.titulo}
                  </h3>
                  <p class="text-gray-600 mb-4 text-sm leading-relaxed transform group-hover/card:translate-x-0.5 transition-transform duration-300">
                    {producto.contenido}
                  </p>
                  
                  <ul class="space-y-2 mb-6">
                    {producto.puntos.slice(0, 3).map((punto, puntoIndex) => (
                      <li 
                        class="flex items-center text-sm text-gray-500 opacity-0"
                        style={`animation: fade-in-right 0.5s ease-out ${0.4 + puntoIndex * 0.1}s forwards`}
                      >
                        <div class="w-6 h-6 rounded-full bg-green-100 flex items-center justify-center mr-3 flex-shrink-0 transform group-hover/card:scale-110 transition-transform duration-300">
                          <svg class="w-3 h-3 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                          </svg>
                        </div>
                        <span class="line-clamp-1 transform group-hover/card:translate-x-1 transition-transform duration-300">{punto}</span>
                      </li>
                    ))}
                  </ul>
                </div>
                
                <div class="absolute inset-0 border-2 border-transparent group-hover/card:border-primary/10 rounded-2xl transition-all duration-500 pointer-events-none"></div>
              </div>
            </div>
          ))}
        </div>
        
        <button 
          id="prev-btn"
          class="absolute left-4 top-1/2 transform -translate-y-1/2 bg-white/90 backdrop-blur-sm hover:bg-white text-primary p-3 rounded-full shadow-xl hover:shadow-2xl transition-all duration-300 hover:scale-110 z-10 opacity-0 group-hover:opacity-100 -translate-x-4 group-hover:translate-x-0"
        >
          <svg class="w-6 h-6 transform hover:-translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        
        <button 
          id="next-btn"
          class="absolute right-4 top-1/2 transform -translate-y-1/2 bg-white/90 backdrop-blur-sm hover:bg-white text-primary p-3 rounded-full shadow-xl hover:shadow-2xl transition-all duration-300 hover:scale-110 z-10 opacity-0 group-hover:opacity-100 translate-x-4 group-hover:translate-x-0"
        >
          <svg class="w-6 h-6 transform hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </button>
        
        <div class="flex justify-center mt-8 space-x-3">
          {datosProductos.productos.map((_, index) => (
            <button 
              class="carrusel-indicador w-3 h-3 rounded-full bg-gray-300 hover:bg-primary transition-all duration-300 hover:scale-125"
              data-index={index}
              onclick={`irASlide(${index})`}
            ></button>
          ))}
        </div>
      </div>
    </div>
  </section>
  
  <div id="producto-modal" class="fixed inset-0 bg-black/50 z-50 hidden items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-4xl w-full max-h-[90vh] overflow-y-auto transform transition-all duration-500 ease-out scale-95 opacity-0">
      <div class="p-6">
        <div class="flex justify-between items-start mb-6">
          <h2 id="modal-titulo" class="text-2xl font-bold text-primary"></h2>
          <button 
            onclick="cerrarModal()"
            class="text-gray-400 hover:text-gray-600 text-2xl transform hover:scale-125 transition-transform duration-300"
          >
            &times;
          </button>
        </div>
        
        <div class="grid md:grid-cols-2 gap-8">
          <div class="overflow-hidden rounded-lg shadow-lg">
            <img 
              id="modal-imagen"
              src=""
              alt=""
              class="w-full h-64 object-cover transform hover:scale-105 transition-transform duration-700"
            />
          </div>
          
          <div>
            <h3 class="text-xl font-semibold mb-4 text-gray-800">Características Principales</h3>
            <ul id="modal-puntos" class="space-y-3 mb-6"></ul>
            
            <div class="bg-blue-50 p-4 rounded-lg mb-6 transform hover:scale-[1.01] transition-transform duration-300">
              <h4 class="font-semibold text-blue-800 mb-2">Descripción</h4>
              <p id="modal-descripcion" class="text-blue-700"></p>
            </div>
            
            <button class="w-full py-3 bg-primary text-white rounded-xl hover:bg-primary/90 transition-all duration-300 font-medium transform hover:-translate-y-0.5 hover:shadow-lg">
              Solicitar cotización
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  interface ProductoType {
    img: string;
    titulo: string;
    contenido: string;
    puntos: string[];
  }

  let isDragging = false;
  let startPosition = 0;
  let currentTranslate = 0;
  let prevTranslate = 0;
  let currentIndex = 0;
  let productos: ProductoType[] = [];
  
  document.addEventListener('DOMContentLoaded', () => {
    const carrusel = document.getElementById('productos-carrusel') as HTMLElement | null;
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');
    const indicadores = document.querySelectorAll('.carrusel-indicador');
    const slides = document.querySelectorAll('.draggable-slide');
    
    if (!carrusel) return;
    
    productos = JSON.parse(carrusel.dataset.productos || '[]');
    
    const totalSlides = indicadores.length;
    
    function getSlidesToShow(): number {
      if (window.innerWidth >= 1280) return 4;
      if (window.innerWidth >= 1024) return 3;
      if (window.innerWidth >= 768) return 2;
      return 1;
    }
    
    function getPositionX(event: MouseEvent | TouchEvent): number {
      return 'pageX' in event ? event.pageX : event.touches[0].clientX;
    }
    
    function animateCarrusel() {
      if (carrusel) {
        carrusel.style.transform = `translateX(${currentTranslate}px)`;
        if (isDragging) requestAnimationFrame(animateCarrusel);
      }
    }
    
    function updateSlideScale() {
      if (!carrusel) return;
      
      const slidesToShow = getSlidesToShow();
      const slideWidth = carrusel.clientWidth / slidesToShow;
      const centerPosition = -currentTranslate;
      
      slides.forEach((slide, index) => {
        const slidePos = index * slideWidth;
        const distanceFromCenter = Math.abs(slidePos - centerPosition);
        const maxDistance = slideWidth * 2;
        const scale = Math.max(0.95, 1 - (distanceFromCenter / maxDistance) * 0.1);

        const htmlSlide = slide as HTMLElement;
        htmlSlide.style.transform = `scale(${scale})`;
        htmlSlide.style.opacity = Math.max(0.7, 1 - (distanceFromCenter / maxDistance) * 0.3).toString();
      });
    }
    
    function setSlideByPosition() {
      const slidesToShow = getSlidesToShow();
      const movedBy = currentTranslate - prevTranslate;
      
      if (movedBy < -100 && currentIndex < totalSlides - slidesToShow) {
        currentIndex += 1;
      }
      
      if (movedBy > 100 && currentIndex > 0) {
        currentIndex -= 1;
      }
      
      setPositionByIndex();
      updateIndicadores();
    }
    
    function setPositionByIndex() {
      if (!carrusel) return;
      
      const slidesToShow = getSlidesToShow();
      const slideWidth = carrusel.clientWidth / slidesToShow;
      currentTranslate = currentIndex * -slideWidth;
      prevTranslate = currentTranslate;
      
      carrusel.style.transition = 'transform 0.5s cubic-bezier(0.22, 0.61, 0.36, 1)';
      carrusel.style.transform = `translateX(${currentTranslate}px)`;
      
      setTimeout(updateSlideScale, 500);
      updateIndicadores();
    }
    
    function updateIndicadores() {
      indicadores.forEach((indicador, index) => {
        const htmlIndicador = indicador as HTMLElement;
        if (index === currentIndex) {
          htmlIndicador.classList.remove('bg-gray-300');
          htmlIndicador.classList.add('bg-primary', 'scale-125');
        } else {
          htmlIndicador.classList.remove('bg-primary', 'scale-125');
          htmlIndicador.classList.add('bg-gray-300');
        }
      });
    }
    
    carrusel.addEventListener('mousedown', (e: MouseEvent) => {
      e.preventDefault();
      isDragging = true;
      startPosition = getPositionX(e);
      carrusel.classList.remove('transition-transform', 'duration-500', 'ease-out');
      carrusel.classList.add('cursor-grabbing');
      requestAnimationFrame(animateCarrusel);
    });
    
    carrusel.addEventListener('mousemove', (e: MouseEvent) => {
      if (isDragging) {
        const currentPosition = getPositionX(e);
        currentTranslate = prevTranslate + currentPosition - startPosition;
        updateSlideScale();
      }
    });
    
    carrusel.addEventListener('mouseup', () => {
      if (isDragging) {
        isDragging = false;
        setSlideByPosition();
        carrusel.classList.add('transition-transform', 'duration-500', 'ease-out');
        carrusel.classList.remove('cursor-grabbing');
      }
    });
    
    carrusel.addEventListener('mouseleave', () => {
      if (isDragging) {
        isDragging = false;
        setSlideByPosition();
        carrusel.classList.add('transition-transform', 'duration-500', 'ease-out');
        carrusel.classList.remove('cursor-grabbing');
      }
    });
    
    carrusel.addEventListener('touchstart', (e: TouchEvent) => {
      isDragging = true;
      startPosition = getPositionX(e);
      carrusel.classList.remove('transition-transform', 'duration-500', 'ease-out');
      requestAnimationFrame(animateCarrusel);
    });
    
    carrusel.addEventListener('touchmove', (e: TouchEvent) => {
      if (isDragging) {
        const currentPosition = getPositionX(e);
        currentTranslate = prevTranslate + currentPosition - startPosition;
        updateSlideScale();
      }
    });
    
    carrusel.addEventListener('touchend', () => {
      if (isDragging) {
        isDragging = false;
        setSlideByPosition();
        carrusel.classList.add('transition-transform', 'duration-500', 'ease-out');
      }
    });
    
    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        const slidesToShow = getSlidesToShow();
        if (currentIndex < totalSlides - slidesToShow) {
          currentIndex += 1;
          setPositionByIndex();
          updateIndicadores();
        }
      });
    }
    
    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        if (currentIndex > 0) {
          currentIndex -= 1;
          setPositionByIndex();
          updateIndicadores();
        }
      });
    }
    
    indicadores.forEach((indicador, index) => {
      indicador.addEventListener('click', () => {
        currentIndex = index;
        setPositionByIndex();
        updateIndicadores();
      });
    });
    
    window.addEventListener('resize', () => {
      setPositionByIndex();
    });
    
    setPositionByIndex();
    updateIndicadores();
    updateSlideScale();
    
    setTimeout(() => {
      slides.forEach((slide, index) => {
        const htmlSlide = slide as HTMLElement;
        htmlSlide.style.animation = `slide-up-fade 0.7s ease-out ${0.2 + index * 0.1}s forwards`;
      });
    }, 100);
  });
  
  window.irASlide = function(index: number) {
    currentIndex = index;
    const carrusel = document.getElementById('productos-carrusel') as HTMLElement | null;
    if (carrusel) {
      const slidesToShow = window.innerWidth >= 1280 ? 4 : window.innerWidth >= 1024 ? 3 : window.innerWidth >= 768 ? 2 : 1;
      const slideWidth = carrusel.clientWidth / slidesToShow;
      currentTranslate = index * -slideWidth;
      prevTranslate = currentTranslate;
      
      carrusel.style.transition = 'transform 0.5s cubic-bezier(0.22, 0.61, 0.36, 1)';
      carrusel.style.transform = `translateX(${currentTranslate}px)`;
      
      document.querySelectorAll('.carrusel-indicador').forEach((indicador, i) => {
        const htmlIndicador = indicador as HTMLElement;
        if (i === index) {
          htmlIndicador.classList.add('bg-primary', 'scale-125');
          htmlIndicador.classList.remove('bg-gray-300');
        } else {
          htmlIndicador.classList.remove('bg-primary', 'scale-125');
          htmlIndicador.classList.add('bg-gray-300');
        }
      });
    }
  };
  
  window.abrirModalProducto = function(index: number) {
    const modal = document.getElementById('producto-modal');
    const modalContent = modal?.querySelector('.bg-white') as HTMLElement | null;
    const titulo = document.getElementById('modal-titulo') as HTMLElement | null;
    const imagen = document.getElementById('modal-imagen') as HTMLImageElement | null;
    const puntos = document.getElementById('modal-puntos') as HTMLElement | null;
    const descripcion = document.getElementById('modal-descripcion') as HTMLElement | null;
    
    if (modal && titulo && imagen && puntos && descripcion && modalContent && productos[index]) {
      const producto = productos[index];
      
      titulo.textContent = producto.titulo;
      imagen.src = producto.img;
      imagen.alt = producto.titulo;
      descripcion.textContent = producto.contenido;
      
      puntos.innerHTML = '';
      if (producto.puntos && producto.puntos.length > 0) {
        producto.puntos.forEach((punto: string, i: number) => {
          const li = document.createElement('li');
          li.className = 'flex items-start border-b border-gray-100 pb-3 opacity-0';
          li.style.animation = `fade-in-up 0.5s ease-out ${i * 0.1}s forwards`;
          li.innerHTML = `
            <div class="w-8 h-8 rounded-full bg-green-100 flex items-center justify-center mr-3 mt-0.5 flex-shrink-0 transform hover:scale-110 transition-transform duration-300">
              <svg class="w-4 h-4 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
            </div>
            <span class="text-gray-700">${punto}</span>
          `;
          puntos.appendChild(li);
        });
      }
      
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
      
      setTimeout(() => {
        modalContent.style.transform = 'scale(1)';
        modalContent.style.opacity = '1';
      }, 10);
    }
  };
  
  function cerrarModal() {
    const modal = document.getElementById('producto-modal');
    const modalContent = modal?.querySelector('.bg-white') as HTMLElement | null;
    
    if (modal && modalContent) {
      modalContent.style.transform = 'scale(0.95)';
      modalContent.style.opacity = '0';
      
      setTimeout(() => {
        modal.classList.remove('flex');
        modal.classList.add('hidden');
        document.body.style.overflow = 'auto';
        modalContent.style.transform = '';
        modalContent.style.opacity = '';
      }, 300);
    }
  }
  
  document.addEventListener('click', (e) => {
    const modal = document.getElementById('producto-modal');
    if (modal && e.target === modal) {
      cerrarModal();
    }
  });
  
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      cerrarModal();
    }
  });
</script>

<style>
  @keyframes slide-up-fade {
    from { opacity: 0; transform: translateY(30px) scale(0.95); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  
  @keyframes fade-in-right {
    from { opacity: 0; transform: translateX(-10px); }
    to { opacity: 1; transform: translateX(0); }
  }
  
  @keyframes fade-in-up {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  
  #productos-carrusel { display: flex; user-select: none; }
  
  .draggable-slide { transition: transform 0.3s ease-out, opacity 0.3s ease-out; }
  
  .cursor-grab { cursor: grab; }
  .cursor-grabbing { cursor: grabbing; }
  
  #producto-modal { transition: opacity 0.3s ease; }
  
  #producto-modal > div { 
    transition: transform 0.3s cubic-bezier(0.22, 0.61, 0.36, 1), 
                opacity 0.3s ease; 
  }
  
  .carrusel-indicador { transition: all 0.3s cubic-bezier(0.22, 0.61, 0.36, 1); }
  
  .line-clamp-1 { 
    overflow: hidden; 
    display: -webkit-box; 
    -webkit-line-clamp: 1; 
    -webkit-box-orient: vertical; 
  }
</style>