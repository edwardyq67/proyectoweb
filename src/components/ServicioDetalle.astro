---
// Servicios.astro - VERSIÓN RESPONSIVA
import { Icon } from 'astro-icon/components';
import "../styles/global.css";
import Contacto from './Contacto';
import Carrusel from './Carrusel';
import Productos from './Productos';

// Recibir props
const { servicioEncontrado, serviciosData } = Astro.props;

// Obtener slug para productos
const servicioSlugParaProductos = servicioEncontrado?.slug || null;
---

<!-- Hero Section -->
<section class="relative py-12 sm:py-16 md:py-20 h-[80vh] flex items-center justify-center overflow-hidden">
  <div 
    class="absolute inset-0 z-0"
    style={`
      background-image: url('${servicioEncontrado.img}');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    `}
  >
    <div class="absolute inset-0 bg-black/80"></div>
  </div>
  
  <div class="container relative z-10 px-4 sm:px-6 mx-auto">
    <div class="max-w-4xl mx-auto text-center">
      <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black text-white mb-4 sm:mb-6 leading-tight">
        {servicioEncontrado.titulo}
      </h1>
      <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center">
        <a 
          href="#contacto"
          class="inline-flex items-center justify-center px-6 sm:px-8 py-3 sm:py-4 bg-primary hover:bg-primary/90 text-white font-semibold rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-1 text-sm sm:text-base"
        >
          <Icon name="mdi:calendar-check" class="w-4 h-4 sm:w-5 sm:h-5 mr-2" />
          Solicitar Cotización
        </a>
        
        {
          (servicioEncontrado.titulo === "Aire acondicionado y climatización" || 
           servicioEncontrado.titulo === "Refrigeración comercial e industrial") && (
            <a 
              href={`https://wa.me/51912909920?text=${encodeURIComponent(`Hola, quiero un asesoramiento para: ${servicioEncontrado.titulo}`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center px-6 sm:px-8 py-3 sm:py-4 bg-green-600 hover:bg-green-700 text-white font-semibold rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-1 text-sm sm:text-base"
            >
              <Icon name="mdi:whatsapp" class="w-4 h-4 sm:w-5 sm:h-5 mr-2" />
              Asesoramiento por WhatsApp
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>

<!-- Sección de Descripción -->
<section class="py-12 sm:py-16 lg:py-24 bg-white">
  <div class="container px-4 sm:px-6 mx-auto">
    <div class="grid lg:grid-cols-2 gap-8 md:gap-12 items-center">
      <div class="relative order-2 lg:order-1">
        <div class="relative rounded-2xl overflow-hidden shadow-2xl">
          <img 
            src={servicioEncontrado.img}
            alt={servicioEncontrado.titulo}
            class="w-full h-auto object-cover"
          />
        </div>
        <div class="absolute -bottom-4 -right-4 w-32 h-32 sm:w-40 sm:h-40 md:w-48 md:h-48 bg-primary/5 rounded-full -z-10"></div>
      </div>

      <div class="order-1 lg:order-2">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-gray-900 mb-4 sm:mb-6">
          {servicioEncontrado.titulo}
        </h2>
        <p class="text-base sm:text-lg text-gray-600 mb-6 leading-relaxed">
          {servicioEncontrado.descripcion_larga}
        </p>
        
        <div class="space-y-3 sm:space-y-4 mt-6 sm:mt-8">
          <div class="flex items-start gap-3 sm:gap-4 p-3 sm:p-4 bg-gray-50 rounded-xl hover:bg-gray-100 transition-colors">
            <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-full bg-primary/10 flex items-center justify-center shrink-0">
              <Icon name="mdi:certificate" class="w-5 h-5 sm:w-6 sm:h-6 text-primary" />
            </div>
            <div>
              <h4 class="font-semibold text-gray-900 mb-1 text-sm sm:text-base">Experiencia Certificada</h4>
              <p class="text-gray-600 text-xs sm:text-sm">Equipo técnico especializado con certificaciones internacionales</p>
            </div>
          </div>
          
          <div class="flex items-start gap-3 sm:gap-4 p-3 sm:p-4 bg-gray-50 rounded-xl hover:bg-gray-100 transition-colors">
            <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-full bg-primary/10 flex items-center justify-center shrink-0">
              <Icon name="mdi:lightning-bolt" class="w-5 h-5 sm:w-6 sm:h-6 text-primary" />
            </div>
            <div>
              <h4 class="font-semibold text-gray-900 mb-1 text-sm sm:text-base">Alta Eficiencia Energética</h4>
              <p class="text-gray-600 text-xs sm:text-sm">Equipos que reducen hasta 40% el consumo eléctrico</p>
            </div>
          </div>
          
          <div class="flex items-start gap-3 sm:gap-4 p-3 sm:p-4 bg-gray-50 rounded-xl hover:bg-gray-100 transition-colors">
            <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-full bg-primary/10 flex items-center justify-center shrink-0">
              <Icon name="mdi:shield-check" class="w-5 h-5 sm:w-6 sm:h-6 text-primary" />
            </div>
            <div>
              <h4 class="font-semibold text-gray-900 mb-1 text-sm sm:text-base">Garantía y Seguridad</h4>
              <p class="text-gray-600 text-xs sm:text-sm">Instalaciones certificadas con garantía extendida</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{servicioEncontrado.DomesticoComercial && servicioEncontrado.DomesticoComercial.length > 0 && (
  <section class="py-12 sm:py-16 lg:py-24 bg-gradient-to-br from-blue-50 to-white">
    <div class="container px-4 sm:px-6 mx-auto">
      <div class="grid lg:grid-cols-2 gap-8 md:gap-12 items-center">
        <div class="relative order-2 lg:order-1">
          <div class="relative rounded-2xl overflow-hidden shadow-2xl">
            <img 
              src={servicioEncontrado.DomesticoComercial[0].img || '/default-service.jpg'}
              alt={servicioEncontrado.DomesticoComercial[0].titulo}
              class="w-full h-auto object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-primary/20 to-transparent"></div>
          </div>
          <div class="absolute -bottom-4 -left-4 w-32 h-32 sm:w-40 sm:h-40 bg-blue-100 rounded-full -z-10"></div>
        </div>

        <div class="order-1 lg:order-2">
          <div class="inline-flex items-center gap-2 px-3 sm:px-4 py-1.5 sm:py-2 bg-blue-100 text-blue-700 rounded-full text-xs sm:text-sm font-medium mb-4 sm:mb-6">
            <Icon name="mdi:home" class="w-3 h-3 sm:w-4 sm:h-4" />
            Servicio para Hogares
          </div>
          
          <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-gray-900 mb-4 sm:mb-6">
            {servicioEncontrado.DomesticoComercial[0].titulo}
          </h2>
          
          <p class="text-base sm:text-lg text-gray-600 mb-6 sm:mb-8 leading-relaxed">
            {servicioEncontrado.DomesticoComercial[0].descripcion_corta}
          </p>

          <div class="space-y-4 sm:space-y-6">
            {servicioEncontrado.DomesticoComercial[0].servicios.map((servicio, index) => (
              <div class="bg-white p-4 sm:p-5 rounded-xl shadow-md hover:shadow-lg transition-shadow duration-300 border border-gray-100">
                <div class="flex items-start gap-3 sm:gap-4">
                  <div class="shrink-0">
                    <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-lg bg-green-50 flex items-center justify-center">
                      <Icon name={servicio.icono || "mdi:check"} class="w-5 h-5 sm:w-6 sm:h-6 text-green-600" />
                    </div>
                  </div>
                  <div>
                    <h4 class="text-lg sm:text-xl font-semibold text-gray-900 mb-1 sm:mb-2">
                      {servicio.nombre}
                    </h4>
                    <p class="text-sm sm:text-base text-gray-600">
                      {servicio.descripcion}
                    </p>
                  </div>
                </div>
              </div>
            ))}
          </div>

          <div class="mt-8 sm:mt-10 p-4 sm:p-6 bg-blue-50 rounded-2xl border border-blue-100">
            <div class="flex items-start gap-2 sm:gap-3">
              <Icon name="mdi:shield-check" class="w-5 h-5 sm:w-6 sm:h-6 text-blue-600 mt-0.5 sm:mt-1 shrink-0" />
              <div>
                <h4 class="font-semibold text-gray-900 mb-1 sm:mb-2 text-sm sm:text-base">Nuestro Compromiso</h4>
                <p class="text-gray-600 text-sm sm:text-base">
                  {servicioEncontrado.DomesticoComercial[0].compromiso}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
)}

{Object.keys(servicioEncontrado.VentilacionClimatizacion).length > 0 && servicioEncontrado.VentilacionClimatizacion.servicios && (
  <section class="py-12 sm:py-16 lg:py-24 bg-black">
    <div class="container px-4 sm:px-6 mx-auto">
      <div class="text-center mb-8 sm:mb-12">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-white mb-2 sm:mb-4">
          {servicioEncontrado.VentilacionClimatizacion.titulo}
        </h2>
        <p class="text-sm sm:text-base md:text-lg text-gray-300 max-w-3xl mx-auto px-4">
          Sistemas especializados para calidad del aire y confort ambiental
        </p>
      </div>

      <div class="grid lg:grid-cols-2 gap-8 md:gap-12 items-center">
        <div class="relative order-2 lg:order-1">
          <div class="relative rounded-2xl overflow-hidden shadow-2xl">
            <img 
              src={servicioEncontrado.VentilacionClimatizacion.img || servicioEncontrado.img}
              alt={servicioEncontrado.VentilacionClimatizacion.titulo}
              class="w-full h-auto object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-primary-600/20 to-transparent"></div>
          </div>
          <div class="absolute -top-4 -left-4 w-32 h-32 sm:w-40 sm:h-40 bg-primary-500/5 rounded-full -z-10"></div>
          <div class="absolute -bottom-4 -right-4 w-24 h-24 sm:w-32 sm:h-32 bg-primary/5 rounded-full -z-10"></div>
        </div>

        <div class="order-1 lg:order-2">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4 mb-6 sm:mb-8">
            {servicioEncontrado.VentilacionClimatizacion.servicios.map((servicioVent, index) => (
              <div class="bg-white p-4 sm:p-5 rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300 border border-gray-100">
                <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-primary-100 flex items-center justify-center mb-2 sm:mb-3">
                  <Icon name={servicioVent.icono} class="w-5 h-5 sm:w-6 sm:h-6 text-primary-600" />
                </div>
                <h4 class="font-semibold text-gray-900 mb-1 sm:mb-2 text-sm sm:text-base">
                  {servicioVent.nombre}
                </h4>
                <p class="text-gray-600 text-xs sm:text-sm">
                  {servicioVent.descripcion}
                </p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
)}

<!-- SECCIÓN DE SECCIONES - CONTENIDO INFORMATIVO -->
{servicioEncontrado.secciones && servicioEncontrado.secciones.length > 0 && (
  <section class="py-12 sm:py-16 lg:py-24 bg-white">
    <div class="container px-4 sm:px-6 mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-16">
        <span class="inline-flex items-center gap-2 px-3 sm:px-4 py-1.5 sm:py-2 bg-primary-50 text-primary-700 rounded-full text-xs sm:text-sm font-medium mb-3 sm:mb-4">
          <Icon name="mdi:chart-box" class="w-3 h-3 sm:w-4 sm:h-4" />
          Información Especializada
        </span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-4 sm:mb-6">
          {servicioEncontrado.secciones[0].titulo}
        </h2>
        {servicioEncontrado.secciones[0].contenido && (
          <p class="text-base sm:text-lg md:text-xl text-gray-600 leading-relaxed px-4">
            {servicioEncontrado.secciones[0].contenido}
          </p>
        )}
      </div>

      {servicioEncontrado.secciones[0].items && Array.isArray(servicioEncontrado.secciones[0].items) && 
       servicioEncontrado.secciones[0].items.length > 0 && (
        <div class="max-w-6xl mx-auto">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 sm:gap-6">
            {servicioEncontrado.secciones[0].items.map((item, idx) => {
              const getIconName = (titulo:any) => {
                if (!titulo) return "mdi:information";
                if (titulo.includes("Salud") || titulo.includes("Hospitalario")) return "mdi:hospital";
                if (titulo.includes("Farmacéutica")) return "mdi:pill";
                if (titulo.includes("Alimentaria") || titulo.includes("Procesamiento")) return "mdi:food";
                if (titulo.includes("Corporativo") || titulo.includes("Comercial")) return "mdi:briefcase";
                if (titulo.includes("Residencial")) return "mdi:home";
                if (titulo.includes("Retail")) return "mdi:store";
                if (titulo.includes("Horeca")) return "mdi:chef-hat";
                return "mdi:information";
              };
              
              return (
                <div 
                  class="flex flex-col md:flex-row items-start gap-4 sm:gap-6 bg-gradient-to-br from-primary-50 to-white rounded-2xl p-6 sm:p-8 md:p-10 border border-primary-100 hover:border-primary-200 hover:shadow-lg transition-all duration-300"
                >
                  <div class="mb-3 md:mb-0">
                    <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-xl bg-primary-50 flex items-center justify-center">
                      <Icon 
                        name={getIconName(item?.titulo)}
                        class="w-6 h-6 sm:w-7 sm:h-7 text-primary-600" 
                      />
                    </div>
                  </div>
                  <div>
                    <h3 class="text-lg sm:text-xl font-semibold text-gray-900 mb-2 sm:mb-3">
                      {item?.titulo || "Sector especializado"}
                    </h3>
                    <p class="text-gray-600 text-xs sm:text-sm leading-relaxed">
                      {item?.descripcion || "Información especializada del sector"}
                    </p>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      )}
    </div>
  </section>
)}

<!-- Carrusel -->
{(servicioEncontrado.Domestico.length > 0 || 
  servicioEncontrado.Comercial.length > 0 || 
  servicioEncontrado.Industrial.length > 0) && ( 
  <Carrusel client:only="react"/>
)}

<!-- Productos -->
{(servicioEncontrado.Domestico.length > 0 || 
  servicioEncontrado.Comercial.length > 0 || 
  servicioEncontrado.Industrial.length > 0) && (
  <Productos client:load servicioSlug={servicioSlugParaProductos} />
)}

<!-- Otros servicios relacionados -->
<section class="py-12 sm:py-16 lg:py-24 bg-gray-50">
  <div class="container px-4 sm:px-6 mx-auto">
    <div class="text-center mb-8 sm:mb-12">
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-gray-900 mb-2 sm:mb-4">
        Servicios Relacionados
      </h2>
      <p class="text-sm sm:text-base md:text-lg text-gray-600 max-w-2xl mx-auto px-4">
        Soluciones completas para todas tus necesidades de climatización
      </p>
    </div>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
      {serviciosData.servicios.filter(s => s.slug !== servicioEncontrado.slug).slice(0, 3).map((servicioRel, index) => (
        <a 
          href={`/${servicioRel.slug}`} 
          class="group relative bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-2xl transition-all duration-500 hover:-translate-y-2"
        >
          <div class="relative h-48 sm:h-56 overflow-hidden">
            <img 
              src={servicioRel.img}
              alt={servicioRel.titulo}
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent"></div>
            <div class="absolute top-3 left-3 sm:top-4 sm:left-4">
              <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-white/20 backdrop-blur-sm flex items-center justify-center">
                <Icon name={servicioRel.icono} class="w-5 h-5 sm:w-6 sm:h-6 text-white" />
              </div>
            </div>
          </div>
          
          <div class="p-4 sm:p-6">
            <h3 class="text-lg sm:text-xl font-bold text-gray-900 mb-2 sm:mb-3 group-hover:text-primary transition-colors">
              {servicioRel.titulo}
            </h3>
            <p class="text-gray-600 text-xs sm:text-sm mb-3 sm:mb-4 line-clamp-2">
              {servicioRel.contenido}
            </p>
            <div class="flex items-center justify-between">
              <span class="text-primary font-semibold group-hover:underline text-sm sm:text-base">
                Ver detalles
              </span>
              <Icon name="mdi:arrow-right" class="w-4 h-4 sm:w-5 sm:h-5 text-primary group-hover:translate-x-2 transition-transform" />
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<Contacto client:load tipo={servicioEncontrado.titulo}/>

<style is:global>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>