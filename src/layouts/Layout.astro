---
// Layout.astro
import { ViewTransitions } from 'astro:transitions';
import Header from '../components/Header.jsx';
import Footer from '../components/Footer.jsx';
import "../styles/global.css";

const { 
  title = 'Teknisolutions - Especialistas en Climatización y Refrigeración', 
  description = 'Soluciones integrales en aire acondicionado, refrigeración industrial, cámaras frigoríficas y sistemas HVAC en Lima, Perú.',
  image = '/Servicios/AireAcodicionadoClimatizacion.webp',
  canonical = Astro.url
} = Astro.props;
---

<!doctype html>
<html lang="es" class="light">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="TS Group - Soluciones Integrales" href="/TS-Group-logo-Color.webp" />
		<meta name="generator" content={Astro.generator} />
		<title>TS Group</title>
		
		<!-- Meta tags SEO -->
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={image} />
		<meta property="og:url" content={canonical} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image} />
		
		<!-- Schema Markup -->
		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "HVACBusiness",
				"name": "Teknisolutions",
				"image": "/TS-Group-logo-Color.webp",
				"description": "{description}"
			}
		</script>
		
		<ViewTransitions />
		
		<slot name="head" />
	</head>
	<body>
		<Header client:load/>
		<slot />
		<Footer client:load/>
	</body>
</html>

<style>
	html {
		scroll-behavior: smooth;
	}
	body {
		margin: 0;
	}
	
	/* Estilos opcionales para personalizar las transiciones */
	::view-transition-old(root) {
		animation: fade-out 0.3s ease;
	}
	
	::view-transition-new(root) {
		animation: fade-in 0.3s ease;
	}
	
	@keyframes fade-in {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
	
	@keyframes fade-out {
		from {
			opacity: 1;
			transform: translateY(0);
		}
		to {
			opacity: 0;
			transform: translateY(-20px);
		}
	}
</style>