---
// Layout.astro
import { ViewTransitions } from 'astro:transitions';
import Header from '../components/Header.jsx';
import Footer from '../components/Footer.jsx';
import "../styles/global.css";
import "../styles/carrusel.css";

const {
  title = 'Teknisolutions - Especialistas en Climatización y Refrigeración',
  description = 'Soluciones integrales en aire acondicionado, refrigeración industrial, cámaras frigoríficas y sistemas HVAC en Lima, Perú. Instalación, mantenimiento y reparación.',
  keywords = 'aire acondicionado, refrigeración, HVAC, climatización, cámaras frigoríficas, mantenimiento industrial, Lima, Perú, Teknisolutions',
  image = '/Nosotros/TS.ico',
  canonical = Astro.url.pathname, // Cambiado a pathname para URL relativa
  ogType = 'website',
  twitterCard = 'summary_large_image',
  author = 'Teknisolutions',
  robots = 'index, follow',
  language = 'es',
  geo = 'PE-Lima',
  themeColor = '#0066cc'
} = Astro.props;

const fullImageUrl = new URL(image, Astro.url).href;
const siteName = 'Teknisolutions Perú';
const canonicalUrl = new URL(canonical, Astro.url).href; // URL completa para canonical
---

<!doctype html>
<html lang="es" prefix="og: https://ogp.me/ns#" class="light">
  <head>
        <!-- Google Tag Manager (único sistema de tracking) -->
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-5DFFWXGL');

      // Seguimiento de navegación con View Transitions
      document.addEventListener('astro:page-load', () => {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({
          event: 'page_view',
          page_title: document.title,
          page_location: window.location.href,
          page_path: window.location.pathname
        });
      });
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <meta name="format-detection" content="telephone=no">
    
    <!-- Favicon y Web App -->
    <link rel="icon" type="image/x-icon" href="/Nosotros/TS.ico" /> <!-- Cambiado image/icon a image/x-icon -->
    <link rel="apple-touch-icon" sizes="180x180" href="/Nosotros/TS.ico">
    <meta name="msapplication-TileColor" content="#0066cc">
    <meta name="theme-color" content={themeColor}>
    <meta name="apple-mobile-web-app-title" content="Teknisolutions">
    <meta name="application-name" content="Teknisolutions">
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={author} />
    <meta name="copyright" content={author} />
    <meta name="robots" content={robots} />
    <meta name="language" content={language} />
    <meta name="geo.region" content={geo} />
    <meta name="geo.placename" content="Jr. María José de Arce 261" />
    <meta name="geo.position" content="-12.0807;-77.09075" />
    <meta name="ICBM" content="-12.0807,-77.09075" />
    <link rel="canonical" href={canonicalUrl} /> <!-- Añadido canonical link -->
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={fullImageUrl} />
    <meta property="og:image:alt" content="Teknisolutions - Soluciones en Climatización" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/x-icon" /> <!-- Cambiado a tipo correcto -->
    
    <!-- Twitter -->
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:site" content="@teknisolutions" />
    <meta name="twitter:creator" content="@teknisolutions" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImageUrl} />
    <meta name="twitter:image:alt" content="Teknisolutions - Soluciones en Climatización" />
    
    <!-- Structured Data / Schema.org -->
    <script type="application/ld+json" set:html={{
      "@context": "https://schema.org",
      "@type": "Organization",
      "@id": "https://teknisolutions.com/#organization",
      "name": "Teknisolutions",
      "alternateName": "Teknisolutions Perú",
      "url": "https://teknisolutions.com",
      "logo": "https://teknisolutions.com/Nosotros/TS.ico",
      "description": description,
      "foundingDate": "2015",
      "address": {
        "@type": "PostalAddress",
        "addressCountry": "PE",
        "addressRegion": "Lima",
        "addressLocality": "Lima",
        "postalCode": "15000",
        "streetAddress": "Jr. María José de Arce 261" // Actualizado con dirección real
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+51-123-456-789",
        "contactType": "customer service",
        "email": "contacto@teknisolutions.com",
        "areaServed": "PE",
        "availableLanguage": ["Spanish"]
      },
      "sameAs": [
        "https://facebook.com/teknisolutions",
        "https://instagram.com/teknisolutions",
        "https://linkedin.com/company/teknisolutions"
      ]
    }} />
    
    <!-- Additional SEO -->
    <meta name="generator" content={Astro.generator} />
    <meta name="rating" content="General" />
    <meta name="revisit-after" content="7 days" />
    <meta name="distribution" content="Global" />
    
    <!-- Preload critical resources -->
    <link rel="preload" href="/styles/global.css" as="style" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    
    <!-- Styles -->
    <link rel="stylesheet" href="/styles/global.css" />
    <link rel="stylesheet" href="/styles/carrusel.css" />
    

    
    <!-- View Transitions -->
    <ViewTransitions />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5DFFWXGL"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    
    <Header client:load />
    <slot />
    <Footer client:load />
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
  }
  
  /* Estilos para las transiciones de vista */
  ::view-transition-old(root) {
    animation: fade-out 0.3s ease;
  }
  
  ::view-transition-new(root) {
    animation: fade-in 0.3s ease;
  }
  
  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

</style>