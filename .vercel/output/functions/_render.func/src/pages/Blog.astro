---
import Layout from '../layouts/Layout.astro';
import BlogData from '../lib/Blog.json';
import { Icon } from 'astro-icon/components';
import "../styles/global.css";

// Obtener artículos destacados
const articulosDestacados = BlogData.articulos.filter(articulo => articulo.destacado);

// Corregir el error de ordenación de fechas
const articulosRecientes = [...BlogData.articulos]
  .sort((a, b) => {
    const dateA = new Date(a.fecha_publicacion).getTime();
    const dateB = new Date(b.fecha_publicacion).getTime();
    return dateB - dateA;
  })
  .slice(0, 6);

// Formatear fecha
function formatearFecha(fecha:any) {
  return new Date(fecha).toLocaleDateString('es-ES', {
    day: 'numeric',
    month: 'long',
    year: 'numeric'
  });
}

// Obtener autor por ID
function obtenerAutor(id:any) {
  return BlogData.autores.find(autor => autor.id === id);
}

// Obtener categoría por ID
function obtenerCategoria(id:any) {
  return BlogData.categorias.find(cat => cat.id === id);
}

// Función segura para obtener categoría
function obtenerCategoriaSegura(id:any) {
  const categoria = obtenerCategoria(id);
  if (!categoria) {
    // Retornar una categoría por defecto
    return {
      id: 0,
      nombre: 'General',
      slug: 'general',
      descripcion: 'Categoría general',
      color: 'bg-gray-500',
      icono: 'mdi:help-circle',
      total_articulos: 0
    };
  }
  return categoria;
}

// Función segura para obtener autor
function obtenerAutorSeguro(id:any) {
  const autor = obtenerAutor(id);
  if (!autor) {
    // Retornar un autor por defecto
    return {
      id: 0,
      nombre: 'Autor del Blog',
      cargo: 'Especialista',
      avatar: '/images/default-avatar.jpg',
      bio: 'Especialista en climatización y ventilación',
      especialidad: 'Climatización General',
      redes: {}
    };
  }
  return autor;
}
---

<Layout title="Blog - Aire Acondicionado y Ventilación">
  
  <!-- Hero Section -->
  <section class="relative py-20 lg:py-28 bg-gradient-to-br from-primary-50 via-white to-blue-50 overflow-hidden">
    <!-- Elementos decorativos -->
    <div class="absolute top-10 left-10 w-72 h-72 bg-primary-100 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-pulse"></div>
    <div class="absolute bottom-10 right-10 w-72 h-72 bg-blue-100 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-pulse" style="animation-delay: 2s;"></div>
    
    <div class="container relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 mb-6">
          <span class="block">Expertos en</span>
          <span class="text-primary bg-gradient-to-r from-primary to-blue-600 bg-clip-text text-transparent">
            Climatización
          </span>
        </h1>
        
        <p class="text-xl text-gray-600 mb-10 max-w-2xl mx-auto leading-relaxed">
          Artículos técnicos, guías de mantenimiento y las últimas tendencias en aire acondicionado y ventilación mecánica.
        </p>
        
        <!-- Stats -->
        <div class="flex flex-wrap justify-center gap-8 mb-12">
          <div class="text-center">
            <div class="text-3xl font-bold text-primary mb-2">{BlogData.metadata.total_articulos}+</div>
            <div class="text-gray-600">Artículos Técnicos</div>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold text-primary mb-2">{BlogData.categorias.length}</div>
            <div class="text-gray-600">Categorías</div>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold text-primary mb-2">{BlogData.autores.length}</div>
            <div class="text-gray-600">Expertos</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Categorías -->
  <section class="py-16 bg-white">
    <div class="container">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          Explora por Categoría
        </h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          Encuentra contenido especializado según tus intereses
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {BlogData.categorias.map((categoria) => (
          <a 
            href={`/blog/categoria/${categoria.slug}`}
            class="group relative bg-white rounded-2xl p-6 border border-gray-200 hover:border-primary/30 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1"
          >
            <div class={`w-12 h-12 ${categoria.color} rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform duration-300`}>
              <Icon name={categoria.icono} class="w-6 h-6 text-white" />
            </div>
            
            <h3 class="text-xl font-semibold text-gray-900 mb-2 group-hover:text-primary transition-colors">
              {categoria.nombre}
            </h3>
            
            <p class="text-gray-600 text-sm mb-4">
              {categoria.descripcion}
            </p>
            
            <div class="flex items-center text-primary font-medium text-sm">
              <span>{categoria.total_articulos} artículos</span>
              <Icon name="mdi:arrow-right" class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" />
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Artículos Destacados -->
  <section class="py-20 bg-gray-50">
    <div class="container">
      <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center mb-12">
        <div>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
            Artículos Destacados
          </h2>
          <p class="text-lg text-gray-600 max-w-2xl">
            Lo más relevante sobre climatización y ventilación
          </p>
        </div>
        
      </div>
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {articulosDestacados.map((articulo) => {
          const autor = obtenerAutorSeguro(articulo.autor_id);
          const categoria = obtenerCategoriaSegura(articulo.categorias[0]);
          
          return (
            <article class="group bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-500 transform hover:-translate-y-2">
              <div class="relative h-64 md:h-72 overflow-hidden">
                <img 
                  src={articulo.img_principal} 
                  alt={articulo.titulo}
                  class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700"
                />
                <div class="absolute top-4 left-4">
                  <span class={`${categoria.color} text-white px-3 py-1 rounded-full text-xs font-semibold`}>
                    {categoria.nombre}
                  </span>
                </div>
              </div>
              
              <div class="p-6">
                <div class="flex items-center gap-4 mb-4">
                  <div class="flex items-center gap-2 text-gray-500 text-sm">
                    <Icon name="mdi:calendar" class="w-4 h-4" />
                    {formatearFecha(articulo.fecha_publicacion)}
                  </div>
                  <div class="flex items-center gap-2 text-gray-500 text-sm">
                    <Icon name="mdi:clock-outline" class="w-4 h-4" />
                    {articulo.tiempo_lectura} lectura
                  </div>
                </div>
                
                <h3 class="text-2xl font-bold text-gray-900 mb-4 group-hover:text-primary transition-colors">
                  <a href={`/blog/${articulo.slug}`}>{articulo.titulo}</a>
                </h3>
                
                <p class="text-gray-600 mb-6 leading-relaxed">
                  {articulo.descripcion_corta}
                </p>
                
                <div class="flex items-center justify-between pt-4 border-t border-gray-100">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-gray-200 overflow-hidden">
                      <img 
                        src={autor.avatar} 
                        alt={autor.nombre}
                        class="w-full h-full object-cover"
                      />
                    </div>
                    <div>
                      <div class="font-medium text-gray-900">{autor.nombre}</div>
                      <div class="text-sm text-gray-500">{autor.cargo}</div>
                    </div>
                  </div>
                  
                  <a 
                    href={`/blog/${articulo.slug}`}
                    class="inline-flex items-center gap-2 text-primary font-semibold hover:gap-3 transition-all"
                  >
                    Leer más
                    <Icon name="mdi:arrow-right" class="w-4 h-4" />
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>


  <!-- Nuestros Expertos -->
  <section class="py-20 bg-gray-50">
    <div class="container">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          Nuestros Expertos
        </h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          Conoce al equipo de profesionales detrás de cada artículo
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {BlogData.autores.map((autor) => (
          <div class="bg-white rounded-2xl p-8 text-center border border-gray-200 hover:shadow-xl transition-shadow duration-300">
            <div class="w-24 h-24 rounded-full overflow-hidden mx-auto mb-6 border-4 border-white shadow-lg">
              <img 
                src={autor.avatar} 
                alt={autor.nombre}
                class="w-full h-full object-cover"
              />
            </div>
            
            <h3 class="text-2xl font-bold text-gray-900 mb-2">{autor.nombre}</h3>
            <div class="text-primary font-semibold mb-4">{autor.cargo}</div>
            
            <p class="text-gray-600 mb-6 text-sm leading-relaxed">
              {autor.bio}
            </p>
            
            <div class="text-sm font-medium text-gray-700 mb-2">Especialidad:</div>
            <div class="inline-block bg-primary/10 text-primary px-4 py-2 rounded-full text-sm font-medium mb-6">
              {autor.especialidad}
            </div>
            
            <div class="flex justify-center gap-4">
              {autor.redes.linkedin && (
                <a 
                  href={`https://linkedin.com/in/${autor.redes.linkedin}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-10 h-10 rounded-full bg-gray-100 flex items-center justify-center text-gray-600 hover:bg-primary hover:text-white transition-colors"
                >
                  <Icon name="mdi:linkedin" class="w-5 h-5" />
                </a>
              )}
              {autor.redes.twitter && (
                <a 
                  href={`https://twitter.com/${autor.redes.twitter}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-10 h-10 rounded-full bg-gray-100 flex items-center justify-center text-gray-600 hover:bg-blue-400 hover:text-white transition-colors"
                >
                  <Icon name="mdi:twitter" class="w-5 h-5" />
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Newsletter -->
  <section class="py-20 bg-gradient-to-r from-primary to-blue-600 text-white">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <Icon name="mdi:newspaper-variant-outline" class="w-16 h-16 mx-auto mb-6" />
        
        <h2 class="text-3xl md:text-4xl font-bold mb-6">
          Mantente Informado
        </h2>
        
        <p class="text-xl mb-10 opacity-90">
          Recibe artículos técnicos, consejos de mantenimiento y novedades del sector directamente en tu correo.
        </p>
        
        <form class="flex flex-col sm:flex-row gap-4 max-w-lg mx-auto">
          <input 
            type="email"
            placeholder="tu@email.com"
            class="flex-1 px-6 py-4 rounded-xl text-gray-900 focus:outline-none focus:ring-2 focus:ring-white"
            required
          />
          <button
            type="submit"
            class="px-8 py-4 bg-white text-primary font-semibold rounded-xl hover:bg-gray-100 transition-colors"
          >
            Suscribirme
          </button>
        </form>
        
        <p class="text-sm opacity-80 mt-4">
          Sin spam. Solo contenido de valor sobre climatización.
        </p>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* Utilidades */
  .line-clamp-2 {
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  
  .line-clamp-3 {
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }
  
  /* Animaciones personalizadas */
  .animate-float-delay {
    animation: float 3s ease-in-out infinite;
    animation-delay: var(--delay, 0s);
  }
</style>